# Exemple de configuration — copier vers backtester/backend/.env puis remplir.
# Les clés peuvent aussi être saisies depuis l'interface (page Configuration) :
# elles sont alors stockées dans backend/data/.keys.env (jamais commité).
# NE JAMAIS commiter de vraies clés.

# FRED / ALFRED — macro US point-in-time. Clé GRATUITE :
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Finnhub — calendrier des résultats d'entreprises. Clé gratuite (limitée) :
# https://finnhub.io/register
FINNHUB_API_KEY=

# Databento — données ES contrat par contrat (GLBX.MDP3, PAYANT à l'usage),
# nécessaire uniquement pour un historique intraday > ~60 jours :
# https://databento.com
DATABENTO_API_KEY=

# Telegram (facultatif) — notification quotidienne du verdict a 15h29 :
# creez un bot avec @BotFather, collez le jeton ici (ou page Configuration),
# puis renseignez le chat_id dans les parametres de notification de l'app.
TELEGRAM_BOT_TOKEN=
