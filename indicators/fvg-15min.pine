//@version=6
// FVG 15 Minutes — Fair Value Gaps détectés sur l'unité de temps 15 minutes.
//
// Fonctionnement :
//   - Détection des FVG haussiers et baissiers sur les bougies 15m clôturées
//     (pattern 3 bougies : gap entre le high de la bougie A et le low de la
//     bougie C, ou l'inverse pour un FVG baissier).
//   - Les zones restent affichées et s'étendent vers la droite tant qu'elles
//     ne sont pas touchées (conservation d'affichage).
//   - Dès que le prix vient toucher la zone (mitigation), la box est soit
//     conservée en grisé et figée (option par défaut), soit supprimée du
//     graphique.
//   - Chaque FVG est classé CONTINUATION (C) ou RETOURNEMENT (R) grâce à un
//     moteur de structure P1->P4 calculé sur les bougies 15m clôturées :
//       * P3 (cassure dans le sens de la tendance)  -> continuation
//       * P4 (cassure qui inverse la tendance)      -> retournement
//       * sinon : FVG dans le sens de la tendance 15m = C, à contre-sens = R.
//   - SIGNAUX au toucher d'une zone (logique reprise du script HA Zones :
//     touche directionnelle + confirmation dans une fenêtre de validité) :
//       * la touche est directionnelle par construction : un FVG haussier est
//         sous le prix (le prix VIENT PAR LE HAUT -> achat), un FVG baissier
//         est au-dessus (le prix VIENT PAR LE BAS -> vente) ;
//       * signal RETOURNEMENT : bougie de confirmation (flip) dans la fenêtre
//         après la touche -> point vert (achat) / point rouge (vente),
//         étiqueté C ou R selon le type de la zone touchée ;
//       * signal PRISE DE LIQUIDITÉ (PL) : la mèche traverse TOUTE la zone
//         puis la clôture reprend le niveau -> signal immédiat.
//   - FILTRE DE PERTINENCE (score de confluence, 5 critères) : momentum
//     Squeeze (LazyBear) dans le sens, tendance 15m alignée, corps de bougie
//     de confirmation fort (x ATR), clôture au-delà de la zone, volume
//     supérieur à sa moyenne. Seuls les signaux atteignant le score minimal
//     s'affichent ; la couleur du point est graduée par le score
//     (clair = score minimal, foncé = tous les critères réunis).
//
// Remarque : l'indicateur fonctionne sur n'importe quelle unité de temps du
// graphique inférieure ou égale à 15 minutes. Sur une unité de temps
// supérieure, certains FVG 15m intrabars ne peuvent pas être détectés
// (limitation de request.security).

indicator("FVG 15min (mitigation au toucher)", shorttitle = "FVG 15m", overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ── Paramètres ──────────────────────────────────────────────────────────────
grpDetect   = "Détection"
tfFVG       = input.timeframe("15",  "Unité de temps des FVG",              group = grpDetect)
minSizePct  = input.float(0.0,       "Taille minimale du gap (%)",          group = grpDetect, minval = 0.0, step = 0.01, tooltip = "Ignore les FVG dont la hauteur est inférieure à ce pourcentage du prix. 0 = tous les FVG.")
maxActive   = input.int(50,          "Nombre max de FVG affichés",          group = grpDetect, minval = 1, maxval = 200)

grpStyle    = "Style"
bullColor   = input.color(color.new(color.teal,   80), "Fond FVG haussier", group = grpStyle)
bearColor   = input.color(color.new(color.red,    80), "Fond FVG baissier", group = grpStyle)
bullBorder  = input.color(color.new(color.teal,   40), "Bordure haussière", group = grpStyle)
bearBorder  = input.color(color.new(color.red,    40), "Bordure baissière", group = grpStyle)
showMidline = input.bool(false,      "Afficher la ligne médiane (CE)",      group = grpStyle)

grpMitig    = "Zones touchées (mitigées)"
keepMitig   = input.bool(true,       "Garder les zones touchées en grisé",  group = grpMitig, tooltip = "Si activé, une zone touchée reste affichée en gris et cesse de s'étendre. Sinon elle est supprimée.")
mitigColor  = input.color(color.new(color.gray, 85), "Fond zone mitigée",   group = grpMitig)
mitigBorder = input.color(color.new(color.gray, 60), "Bordure zone mitigée", group = grpMitig)
maxMitig    = input.int(30,          "Nombre max de zones mitigées",        group = grpMitig, minval = 1, maxval = 200)

grpStruct   = "Structure (continuation / retournement)"
fvgFilter   = input.string("Tous", "FVG affichés", options = ["Tous", "Continuation", "Retournement"], group = grpStruct, tooltip = "Continuation = FVG créé par un P3 15m ou dans le sens de la tendance 15m. Retournement = FVG créé par un P4 15m ou à contre-tendance.")
showTag     = input.bool(true,  "Étiquette C / R dans la box",           group = grpStruct)
showStruct  = input.bool(false, "Labels de structure 15m (P3 / P4)",     group = grpStruct)
p3Color     = input.color(color.red,  "Couleur P3 (continuation)",       group = grpStruct)
p4Color     = input.color(color.lime, "Couleur P4 (retournement)",       group = grpStruct)

grpSig      = "Signaux (retournement / prise de liquidité)"
showSignals = input.bool(true, "Afficher les signaux au toucher des FVG", group = grpSig)
sigWindow   = input.int(3,     "Fenêtre de validité après la touche (bougies)", group = grpSig, minval = 0, maxval = 50, tooltip = "Nombre de bougies après la touche pendant lesquelles une confirmation peut déclencher le signal. 0 = la confirmation doit avoir lieu sur la bougie de la touche elle-même.")
needFlip    = input.bool(true, "Retournement : exiger un flip de bougie", group = grpSig, tooltip = "Activé : la bougie de confirmation doit être un retournement (clôture haussière après une clôture baissière, ou l'inverse). Désactivé : une simple bougie dans le sens du signal suffit.")
useSweep    = input.bool(true, "Signal prise de liquidité (PL)", group = grpSig, tooltip = "La mèche traverse toute la zone (liquidité prise) puis la clôture revient au-delà du niveau : signal immédiat, étiqueté PL.")
bullSigCol  = input.color(color.new(color.green, 0), "Signal achat", group = grpSig, inline = "sc")
bearSigCol  = input.color(color.new(color.red, 0),   "Signal vente", group = grpSig, inline = "sc")

grpFilt     = "Filtre de pertinence (score de confluence)"
useScore    = input.bool(true, "Activer le filtre par score", group = grpFilt, tooltip = "Chaque signal est noté sur les critères actifs ci-dessous. Seuls ceux atteignant le score minimal s'affichent. Le score est affiché dans le label et détaillé dans son infobulle.")
minScore    = input.int(3,     "Score minimal requis", group = grpFilt, minval = 0, maxval = 5, tooltip = "Si moins de critères sont actifs que ce seuil, le seuil est abaissé au nombre de critères actifs.")
useFMom     = input.bool(true, "Momentum Squeeze (LazyBear) dans le sens", group = grpFilt)
momLen      = input.int(20,    "Longueur du momentum", group = grpFilt, minval = 5)
useFTrend   = input.bool(true, "Tendance 15m (P1-P4) alignée", group = grpFilt)
useFBody    = input.bool(true, "Corps de la bougie de confirmation fort", group = grpFilt, inline = "fb")
bodyMinAtr  = input.float(0.5, "x ATR(14)", group = grpFilt, inline = "fb", minval = 0.1, step = 0.1)
useFClose   = input.bool(true, "Clôture au-delà de la zone touchée", group = grpFilt)
useFVol     = input.bool(true, "Volume supérieur à sa moyenne 20", group = grpFilt, tooltip = "Ignoré automatiquement si le symbole ne fournit pas de volume.")
gradeColor  = input.bool(true, "Couleur graduée par le score", group = grpFilt, tooltip = "Clair = score minimal, foncé = tous les critères réunis. Désactivé : couleurs fixes du groupe Signaux.")

// ── Stockage des FVG actifs ────────────────────────────────────────────────
// Chaque FVG actif = une box + son sens (true = haussier) + sa ligne médiane.
var array<box>    fvgBoxes  = array.new<box>()
var array<bool>   fvgIsBull = array.new<bool>()
var array<line>   fvgMid    = array.new<line>()
var array<string> fvgTag    = array.new<string>()

// Zones déjà touchées, conservées en grisé (si l'option est activée).
var array<box>  mitigBoxes = array.new<box>()

// Touche en attente de confirmation (une par sens ; la plus récente gagne).
var int    pendBullBar = na
var float  pendBullTop = na
var float  pendBullBot = na
var string pendBullTag = ""
var int    pendBearBar = na
var float  pendBearTop = na
var float  pendBearBot = na
var string pendBearTag = ""

// ── Moteur de structure P1-P4 (repris du LIQUIDITY DETECTOR) ──────────────
// Pas de dessin : retourne la tendance et les événements P3 (continuation,
// cassure dans le sens de la tendance) / P4 (retournement, cassure qui
// inverse la tendance), calculés sur les bougies 15m clôturées.
f_structure(float o, float h, float l, float c, bool do_step) =>
    var int   tr  = 1
    var int   stt = 0
    var float p1e = na
    var float p1o = na
    var float p2e = na
    var float pp2 = na
    var float pp1 = na
    var bool  hp1 = false
    bool e_p3up = false
    bool e_p3dn = false
    bool e_p4up = false
    bool e_p4dn = false
    if do_step
        if na(p1e)
            tr  := c >= o ? 1 : -1
            p1e := c >= o ? h : l
            p1o := c >= o ? l : h
            pp2 := c >= o ? h : l
        if tr == 1
            if stt == 0 and h > p1e
                p1e := h
                p1o := l
                hp1 := true
            if stt == 0 and h <= p1e and l < p1o
                p2e := l
                stt := 1
            if stt == 1 and l < p2e
                p2e := l
            if stt == 1 and c > p1e
                e_p3up := true
                pp2 := p2e
                pp1 := na
                hp1 := false
                p1e := h
                p1o := l
                p2e := na
                stt := 0
            bool tdn = (not na(pp2) and c < pp2) or (hp1 and not na(pp1) and c < pp1)
            if stt == 1 and tdn and not (c > p1e)
                e_p4dn := true
                pp2 := na
                pp1 := p1e
                hp1 := true
                tr  := -1
                stt := 0
                p1e := l
                p1o := h
                p2e := na
        if tr == -1
            if stt == 0 and l < p1e
                p1e := l
                p1o := h
                hp1 := true
            if stt == 0 and l >= p1e and h > p1o
                p2e := h
                stt := 1
            if stt == 1 and h > p2e
                p2e := h
            if stt == 1 and c < p1e
                e_p3dn := true
                pp2 := p2e
                pp1 := na
                hp1 := false
                p1e := l
                p1o := h
                p2e := na
                stt := 0
            bool tup = (not na(pp2) and c > pp2) or (hp1 and not na(pp1) and c > pp1)
            if stt == 1 and tup and not (c < p1e)
                e_p4up := true
                pp2 := na
                pp1 := p1e
                hp1 := true
                tr  := 1
                stt := 0
                p1e := h
                p1o := l
                p2e := na
    [tr, e_p3up, e_p3dn, e_p4up, e_p4dn]

// ── Données 15 minutes ─────────────────────────────────────────────────────
// À l'ouverture d'une nouvelle bougie 15m, la bougie [1] vient de clôturer.
// Le pattern FVG complet utilise donc les bougies [1] (C), [2] (B) et [3] (A).
[h1, l1, h3, l3, t1, o1, c1] = request.security(syminfo.tickerid, tfFVG,
     [high[1], low[1], high[3], low[3], time[1], open[1], close[1]],
     lookahead = barmerge.lookahead_off)

new15mBar = timeframe.change(tfFVG)

// Structure 15m mise à jour à chaque bougie 15m clôturée.
[stTrend, p3up, p3dn, p4up, p4dn] = f_structure(o1, h1, l1, c1, new15mBar and not na(c1))

// Classement du FVG qui vient de se former (bougie C = la cassure) :
// P3 -> continuation, P4 -> retournement, sinon selon la tendance 15m.
bullType = p3up ? "C" : p4up ? "R" : stTrend == 1  ? "C" : "R"
bearType = p3dn ? "C" : p4dn ? "R" : stTrend == -1 ? "C" : "R"
f_pass(string typ) =>
    fvgFilter == "Tous" or (fvgFilter == "Continuation" and typ == "C") or (fvgFilter == "Retournement" and typ == "R")

// FVG haussier : le low de C est au-dessus du high de A → gap [h3 ; l1]
bullFVG = new15mBar and l1 > h3
// FVG baissier : le high de C est en dessous du low de A → gap [h1 ; l3]
bearFVG = new15mBar and h1 < l3

// Filtre de taille minimale
gapTop    = bullFVG ? l1 : l3
gapBottom = bullFVG ? h3 : h1
gapSizeOk = (gapTop - gapBottom) / close * 100 >= minSizePct

// ── Création des boxes ─────────────────────────────────────────────────────
createFVG(bool isBull, float top, float bottom, int startTime, string tag) =>
    b = box.new(startTime, top, time, bottom,
         xloc         = xloc.bar_time,
         extend       = extend.right,
         bgcolor      = isBull ? bullColor  : bearColor,
         border_color = isBull ? bullBorder : bearBorder,
         border_width = 1,
         text         = showTag ? tag : "",
         text_color   = isBull ? bullBorder : bearBorder,
         text_size    = size.tiny,
         text_halign  = text.align_right,
         text_valign  = isBull ? text.align_top : text.align_bottom)
    m = showMidline ?
         line.new(startTime, (top + bottom) / 2, time, (top + bottom) / 2,
             xloc   = xloc.bar_time,
             extend = extend.right,
             color  = isBull ? bullBorder : bearBorder,
             style  = line.style_dotted) : line(na)
    array.push(fvgBoxes,  b)
    array.push(fvgIsBull, isBull)
    array.push(fvgMid,    m)
    array.push(fvgTag,    tag)

if barstate.isconfirmed or barstate.ishistory
    if bullFVG and gapSizeOk and f_pass(bullType)
        createFVG(true, l1, h3, t1, bullType)
    if bearFVG and gapSizeOk and f_pass(bearType)
        createFVG(false, l3, h1, t1, bearType)
    // Labels de structure 15m (optionnels)
    if showStruct
        if p3up
            label.new(bar_index, low,  "P3+", style = label.style_label_up,   color = p3Color, textcolor = color.white, size = size.tiny)
        if p3dn
            label.new(bar_index, high, "P3-", style = label.style_label_down, color = p3Color, textcolor = color.white, size = size.tiny)
        if p4up
            label.new(bar_index, low,  "P4^", style = label.style_label_up,   color = p4Color, textcolor = color.white, size = size.tiny)
        if p4dn
            label.new(bar_index, high, "P4v", style = label.style_label_down, color = p4Color, textcolor = color.white, size = size.tiny)

// Limite du nombre de FVG affichés : on supprime les plus anciens.
while array.size(fvgBoxes) > maxActive
    box.delete(array.shift(fvgBoxes))
    line.delete(array.shift(fvgMid))
    array.shift(fvgIsBull)
    array.shift(fvgTag)

// ── Mitigation : suppression dès que le prix touche la zone ───────────────
// FVG haussier (zone sous le prix)  → touché quand le low revient à son top.
// FVG baissier (zone au-dessus)     → touché quand le high revient à son bottom.
if array.size(fvgBoxes) > 0
    for i = array.size(fvgBoxes) - 1 to 0
        b      = array.get(fvgBoxes, i)
        isBull = array.get(fvgIsBull, i)
        topLvl = box.get_top(b)
        botLvl = box.get_bottom(b)
        touched = isBull ? low <= topLvl : high >= botLvl
        if touched
            // Touche directionnelle (reversal) : FVG haussier = le prix vient
            // par le haut -> achat en attente ; FVG baissier = par le bas ->
            // vente en attente. La confirmation est cherchée ensuite.
            if isBull
                pendBullBar := bar_index
                pendBullTop := topLvl
                pendBullBot := botLvl
                pendBullTag := array.get(fvgTag, i)
            else
                pendBearBar := bar_index
                pendBearTop := topLvl
                pendBearBot := botLvl
                pendBearTag := array.get(fvgTag, i)
            if keepMitig
                // La zone est conservée en grisé : elle cesse de s'étendre
                // et est figée au moment du toucher.
                box.set_extend(b, extend.none)
                box.set_right(b, time)
                box.set_bgcolor(b, mitigColor)
                box.set_border_color(b, mitigBorder)
                array.push(mitigBoxes, b)
            else
                box.delete(b)
            line.delete(array.get(fvgMid, i))
            array.remove(fvgBoxes, i)
            array.remove(fvgIsBull, i)
            array.remove(fvgMid, i)
            array.remove(fvgTag, i)

// Limite du nombre de zones mitigées conservées : les plus anciennes partent.
while array.size(mitigBoxes) > maxMitig
    box.delete(array.shift(mitigBoxes))

// ── Score de confluence ─────────────────────────────────────────────────────
// Momentum Squeeze (LazyBear) : régression linéaire de l'écart du prix à son
// canal médian. Inflexion dans le sens du signal = critère validé.
momSrc = close - math.avg(math.avg(ta.highest(high, momLen), ta.lowest(low, momLen)), ta.sma(close, momLen))
momVal = ta.linreg(momSrc, momLen, 0)
momUp  = momVal > momVal[1]
momDn  = momVal < momVal[1]
atr14s = ta.atr(14)
volSma = ta.sma(volume, 20)

// Note chaque critère actif : [score, max possible, détail pour l'infobulle].
f_score(bool isBuy, float zTop, float zBot) =>
    int sc = 0
    int mx = 0
    string why = ""
    if useFMom
        mx += 1
        bool ok1 = isBuy ? momUp : momDn
        sc += ok1 ? 1 : 0
        why += (ok1 ? "✓" : "✗") + " Momentum dans le sens\n"
    if useFTrend
        mx += 1
        bool ok2 = isBuy ? stTrend == 1 : stTrend == -1
        sc += ok2 ? 1 : 0
        why += (ok2 ? "✓" : "✗") + " Tendance 15m alignée\n"
    if useFBody
        mx += 1
        bool ok3 = math.abs(close - open) >= bodyMinAtr * atr14s
        sc += ok3 ? 1 : 0
        why += (ok3 ? "✓" : "✗") + " Corps de bougie fort\n"
    if useFClose
        mx += 1
        bool ok4 = isBuy ? close > zTop : close < zBot
        sc += ok4 ? 1 : 0
        why += (ok4 ? "✓" : "✗") + " Clôture au-delà de la zone\n"
    if useFVol and not na(volSma)
        mx += 1
        bool ok5 = volume > volSma
        sc += ok5 ? 1 : 0
        why += (ok5 ? "✓" : "✗") + " Volume > moyenne 20\n"
    [sc, mx, why]

// ── Signaux : confirmation après la touche d'un FVG ────────────────────────
// Expiration des touches trop anciennes (hors fenêtre de validité).
if not na(pendBullBar) and bar_index - pendBullBar > sigWindow
    pendBullBar := na
if not na(pendBearBar) and bar_index - pendBearBar > sigWindow
    pendBearBar := na

// Déclencheurs de confirmation (sur la bougie du graphique) :
//   - flip : retournement de bougie (clôture qui change de camp)
//   - sinon : simple bougie dans le sens du signal
flipUp   = close > open and close[1] <= open[1]
flipDown = close < open and close[1] >= open[1]

bool   buySig   = false
bool   sellSig  = false
string buyTxt   = ""
string sellTxt  = ""
int    buyScore = 0
int    buyMax   = 0
string buyWhy   = ""
int    sellScore = 0
int    sellMax   = 0
string sellWhy   = ""

if showSignals and not na(pendBullBar) and bar_index - pendBullBar <= sigWindow
    // Prise de liquidité : la mèche traverse TOUTE la zone (sous son bas)
    // puis la clôture reprend le niveau.
    bool sweepUp = useSweep and low < pendBullBot and close > pendBullBot
    bool confUp  = needFlip ? flipUp : close > open
    if sweepUp or confUp
        [sc, mx, why] = f_score(true, pendBullTop, pendBullBot)
        // Score insuffisant : la touche reste en attente, une meilleure
        // confirmation peut encore arriver dans la fenêtre.
        if not useScore or sc >= math.min(minScore, mx)
            buySig   := true
            buyTxt   := sweepUp ? "PL" : pendBullTag
            buyScore := sc
            buyMax   := mx
            buyWhy   := why
            pendBullBar := na

if showSignals and not na(pendBearBar) and bar_index - pendBearBar <= sigWindow
    bool sweepDn = useSweep and high > pendBearTop and close < pendBearTop
    bool confDn  = needFlip ? flipDown : close < open
    if sweepDn or confDn
        [sc, mx, why] = f_score(false, pendBearTop, pendBearBot)
        if not useScore or sc >= math.min(minScore, mx)
            sellSig   := true
            sellTxt   := sweepDn ? "PL" : pendBearTag
            sellScore := sc
            sellMax   := mx
            sellWhy   := why
            pendBearBar := na

if buySig
    color bCol = gradeColor and buyMax > 0 ? color.from_gradient(buyScore, 0, buyMax, #a5d6a7, #1b5e20) : bullSigCol
    string bTip = (buyTxt == "PL" ? "Prise de liquidité sur FVG haussier" : buyTxt == "C" ? "Retournement sur FVG haussier de continuation" : "Retournement sur FVG haussier de retournement") + "\nScore " + str.tostring(buyScore) + "/" + str.tostring(buyMax) + "\n" + buyWhy
    label.new(bar_index, low, "▲ " + buyTxt + (useScore ? " " + str.tostring(buyScore) + "/" + str.tostring(buyMax) : ""), style = label.style_label_up, color = bCol, textcolor = color.white, size = size.small, tooltip = bTip)
if sellSig
    color sCol = gradeColor and sellMax > 0 ? color.from_gradient(sellScore, 0, sellMax, #ef9a9a, #b71c1c) : bearSigCol
    string sTip = (sellTxt == "PL" ? "Prise de liquidité sur FVG baissier" : sellTxt == "C" ? "Retournement sur FVG baissier de continuation" : "Retournement sur FVG baissier de retournement") + "\nScore " + str.tostring(sellScore) + "/" + str.tostring(sellMax) + "\n" + sellWhy
    label.new(bar_index, high, "▼ " + sellTxt + (useScore ? " " + str.tostring(sellScore) + "/" + str.tostring(sellMax) : ""), style = label.style_label_down, color = sCol, textcolor = color.white, size = size.small, tooltip = sTip)

// ── Alertes ────────────────────────────────────────────────────────────────
alertcondition(buySig,  "Signal ACHAT sur FVG",  "Signal haussier au toucher d'un FVG 15m (confirmation ou prise de liquidité)")
alertcondition(sellSig, "Signal VENTE sur FVG",  "Signal baissier au toucher d'un FVG 15m (confirmation ou prise de liquidité)")
alertcondition(bullFVG and gapSizeOk and bullType == "C", "FVG haussier — continuation", "Nouveau FVG 15m haussier de continuation (P3)")
alertcondition(bullFVG and gapSizeOk and bullType == "R", "FVG haussier — retournement", "Nouveau FVG 15m haussier de retournement (P4)")
alertcondition(bearFVG and gapSizeOk and bearType == "C", "FVG baissier — continuation", "Nouveau FVG 15m baissier de continuation (P3)")
alertcondition(bearFVG and gapSizeOk and bearType == "R", "FVG baissier — retournement", "Nouveau FVG 15m baissier de retournement (P4)")
