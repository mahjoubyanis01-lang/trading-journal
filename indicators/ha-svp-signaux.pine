//@version=6
// =============================================================================
//  HA + SVP + Niveaux horaires -- Signaux de retournement par zones
//
//  1) Bougies Heiken Ashi colorees par le momentum Squeeze (LazyBear).
//  2) NIVEAUX ACTIVATEURS (obligatoires : il faut en toucher un pour
//     confirmer un signal) :
//        - SVP fige : VAH/VAL de la veille (J-1, chaque touche) et zones
//          anciennes jamais touchees (J-2+, premiere touche seulement)
//        - SVP evolutif : VAH/VAL evolutives de la seance EN COURS
//          (le POC est affiche mais n'active rien)
//  3) NIVEAUX DE CONFLUENCE (n'activent pas seuls, renforcent le signal) :
//        - ouvertures horaires (00:00, 06:00, 09:00, 10:00, 15:30, 22:00)
//  4) VALIDATION DIRECTIONNELLE (logique de reversal) :
//        - ACHAT : le prix doit etre VENU PAR LE HAUT (il baisse jusqu'a
//          toucher le niveau), puis signal -> point VERT
//        - VENTE : le prix doit etre VENU PAR LE BAS (il monte jusqu'a
//          toucher le niveau), puis signal -> point ROUGE
//  5) COULEUR GRADUEE PAR LA CONFLUENCE : plus il y a de niveaux touches
//     dans la fenetre (activateurs + horaires), plus le point est fonce :
//     vert clair -> vert fonce, rouge clair -> rouge fonce.
// =============================================================================
indicator("HA + SVP + Niveaux horaires -- Signaux", "HA Zones", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

//========================== INPUTS ==========================
grpSqz = "Squeeze Momentum (LazyBear)"
bbLength     = input.int(20, "BB Length", group = grpSqz)
bbMult       = input.float(2.0, "BB MultFactor", group = grpSqz)
kcLength     = input.int(20, "KC Length", group = grpSqz)
kcMult       = input.float(1.5, "KC MultFactor", group = grpSqz)
useTrueRange = input.bool(true, "Use TrueRange (KC)", group = grpSqz)

grpColor = "Coloration / Graduation"
normLen   = input.int(100, "Fenetre de normalisation du momentum", group = grpColor)
dampAlpha = input.int(55, "Transparence en phase de ralentissement", group = grpColor, minval = 0, maxval = 100)

grpSqzShow  = "Affichage squeeze"
showSqzDots = input.bool(true, "Afficher les points de squeeze sous les bougies", group = grpSqzShow)

grpSig = "Signaux de retournement"
showSignals   = input.bool(true, "Afficher les signaux (point vert / point rouge)", group = grpSig)
needMomentum  = input.bool(true, "Exiger une inflexion du momentum", group = grpSig)
minExtreme    = input.int(30, "Extreme minimal avant retournement (0-100)", group = grpSig, minval = 0, maxval = 100, tooltip = "0 = desactive")
extremeLookback = input.int(10, "Barres de recherche de l'extreme", group = grpSig, minval = 1)

grpZone = "Validation par zones"
useZoneFilter = input.bool(true, "Exiger la touche d'un niveau ACTIVATEUR", group = grpZone)
validBars     = input.int(3, "Fenetre de validite apres la touche (barres)", minval = 0, maxval = 50, group = grpZone, tooltip = "0 = la touche doit avoir lieu sur la bougie du signal elle-meme.")
dirTouch      = input.bool(true, "Touche directionnelle (reversal)", group = grpZone, tooltip = "Achat : prix venu PAR LE HAUT (baisse jusqu'au niveau). Vente : prix venu PAR LE BAS (hausse jusqu'au niveau). Desactive : toute touche valide les deux sens.")
useJ1         = input.bool(true, "Activateur : VAH/VAL de la veille (J-1)", group = grpZone)
useUntouched  = input.bool(true, "Activateur : zones SVP jamais touchees", group = grpZone)
useEvo        = input.bool(true, "Activateur : VAH/VAL evolutives (seance en cours)", group = grpZone)
useHourly     = input.bool(true, "Confluence : niveaux d'ouverture horaires", group = grpZone)
hlFirstTouchOnly = input.bool(false, "Niveaux horaires : premiere touche seulement", group = grpZone)
confMax       = input.int(4, "Confluence pour la couleur la plus foncee", minval = 2, maxval = 10, group = grpZone, tooltip = "Nombre de niveaux touches dans la fenetre a partir duquel le point atteint sa couleur la plus foncee. 1 niveau = couleur claire.")

grpTime = "Filtre horaire des signaux"
useTimeFilter = input.bool(true, "Limiter les signaux a une plage horaire", group = grpTime)
sigSession    = input.session("1530-0000", "Plage horaire (fuseau des niveaux horaires)", group = grpTime, tooltip = "Par defaut de 15:30 a 00:00. Les touches de niveaux restent comptees toute la journee ; seul l'AFFICHAGE du signal est limite a cette plage.")

grpTrade = "Entree / SL / TP (box)"
showTrade  = input.bool(true, "Afficher entree + box SL/TP sur chaque signal", group = grpTrade)
slLen      = input.int(5, "Bougies pour le SL (plus bas / plus haut)", minval = 1, maxval = 50, group = grpTrade, tooltip = "Achat : SL = plus bas des N dernieres bougies. Vente : SL = plus haut des N dernieres bougies.")
tpCol      = input.color(color.new(color.green, 80), "Box TP", group = grpTrade, inline = "tc")
slCol      = input.color(color.new(color.red, 80),   "Box SL", group = grpTrade, inline = "tc")
entCol     = input.color(color.new(color.gray, 0),   "Entree", group = grpTrade, inline = "tc")
showPD     = input.bool(true, "Afficher PDH / PDL (extremes de la veille)", group = grpTrade)
fallbackRR = input.float(2.0, "RR par defaut si aucun niveau cible", minval = 0.5, step = 0.5, group = grpTrade, tooltip = "Quand aucun niveau TP n'existe dans le sens du trade (ou que le plus proche depasse la distance max ci-dessous), le TP est place a ce multiple du risque (distance entree-SL). La box TP est alors marquee 'TP RR'.")
maxTPatr   = input.float(0.0, "Distance max du TP niveau (x ATR, 0 = sans limite)", minval = 0.0, step = 0.5, group = grpTrade, tooltip = "Si le niveau cible le plus proche est plus loin que ce multiple de l'ATR(14), il est ignore et le TP RR par defaut est utilise. Evite les box TP geantes vers un niveau tres lointain.")

grpSvp = "Session Volume Profile"
calc_ticks = input.int(1,    "Precision du calcul (ticks par niveau)", minval=1, maxval=50, group = grpSvp)
percent    = input.float(70.,"Value Area Volume %", minval=0, maxval=100, group = grpSvp)
keepSess   = input.int(60,   "Seances conservees a l'ecran", minval=1, maxval=240, group = grpSvp)
showEvo    = input.bool(true, "Afficher VAH/VAL evolutives", group = grpSvp)
show_poc   = input.bool(true, "Afficher le POC evolutif", group = grpSvp)

grpGen = "Niveaux horaires - reglages"
tz          = input.string("Europe/Paris", "Fuseau horaire", options=["Europe/Paris", "Europe/London", "America/New_York", "UTC", "Exchange"], group=grpGen)
extendRight = input.bool(false, "Prolonger les lignes a droite (infini)", group=grpGen)
showLabels  = input.bool(true, "Afficher les etiquettes", group=grpGen)
showPrice   = input.bool(true, "Afficher le prix dans l'etiquette", group=grpGen)
lineWidth   = input.int(1, "Epaisseur des lignes", minval=1, maxval=4, group=grpGen)
lineStyleIn = input.string("Pointilles", "Style des lignes", options=["Plein", "Pointilles", "Tirets"], group=grpGen)
labelSizeIn = input.string("Petit", "Taille des etiquettes", options=["Minuscule", "Petit", "Normal"], group=grpGen)
histDays    = input.int(5, "Nombre de jours d'historique", minval=1, maxval=30, group=grpGen)

grpLvl = "Niveaux horaires"
show00  = input.bool(true, "Minuit (00:00)",  group=grpLvl, inline="l00")
col00   = input.color(color.new(color.white, 0),  "", group=grpLvl, inline="l00")
show06  = input.bool(true, "06:00",           group=grpLvl, inline="l06")
col06   = input.color(color.new(color.aqua, 0),   "", group=grpLvl, inline="l06")
show09  = input.bool(true, "09:00",           group=grpLvl, inline="l09")
col09   = input.color(color.new(color.orange, 0), "", group=grpLvl, inline="l09")
show10  = input.bool(true, "10:00",           group=grpLvl, inline="l10")
col10   = input.color(color.new(color.yellow, 0), "", group=grpLvl, inline="l10")
show1530 = input.bool(true, "15:30",          group=grpLvl, inline="l1530")
col1530  = input.color(color.new(color.lime, 0),  "", group=grpLvl, inline="l1530")
show22  = input.bool(true, "22:00",           group=grpLvl, inline="l22")
col22   = input.color(color.new(color.fuchsia, 0), "", group=grpLvl, inline="l22")

//========================== HEIKEN ASHI (OHLC) ==========================
haTicker = ticker.heikinashi(syminfo.tickerid)
haOpen   = request.security(haTicker, timeframe.period, open)
haHigh   = request.security(haTicker, timeframe.period, high)
haLow    = request.security(haTicker, timeframe.period, low)
haClose  = request.security(haTicker, timeframe.period, close)

//========================== SQUEEZE MOMENTUM (LazyBear) ==========================
source = close
basis  = ta.sma(source, bbLength)
dev    = bbMult * ta.stdev(source, bbLength)
upperBB = basis + dev
lowerBB = basis - dev

ma      = ta.sma(source, kcLength)
rangeV  = useTrueRange ? ta.tr(true) : (high - low)
rangema = ta.sma(rangeV, kcLength)
upperKC = ma + rangema * kcMult
lowerKC = ma - rangema * kcMult

sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)
noSqz  = not sqzOn and not sqzOff

val = ta.linreg(source - math.avg(math.avg(ta.highest(high, kcLength), ta.lowest(low, kcLength)), ta.sma(close, kcLength)), kcLength, 0)

//========================== GRADUATION DE COULEUR ==========================
normVal = 100 * nz(val) / math.max(ta.highest(math.abs(val), normLen), 1e-10)
normVal := math.max(math.min(normVal, 100), -100)

strengthening = val > 0 ? (val > nz(val[1])) : (val < nz(val[1]))

baseColor = normVal >= 0 ?
     color.from_gradient(normVal, 0, 100, color.new(color.gray, 45), color.new(#cd00db, 0)) :
     color.from_gradient(normVal, -100, 0, color.new(color.red, 0), color.new(color.gray, 45))

haColor = strengthening ? baseColor : color.new(baseColor, dampAlpha)

//========================== TOUCHES (etat du bar courant) ==========================
// ACTIVATEURS : au moins une touche requise pour valider un signal.
//   actBullTouch = activateur touche PAR LE HAUT (valide les achats)
//   actBearTouch = activateur touche PAR LE BAS  (valide les ventes)
// CONFLUENCE : nombre de touches "fraiches" (non repetees d'une barre sur
// l'autre) de TOUS les niveaux (activateurs + horaires), pour la couleur.
bool actBullTouch = false
bool actBearTouch = false
int  freshBull = 0
int  freshBear = 0

// Direction d'approche d'un niveau : d'ou venait le prix ?
f_touchDir(lv) =>
    float ref = nz(close[1], open)
    bool fromAbove = ref > lv or (ref == lv and open > lv)
    bool fromBelow = ref < lv or (ref == lv and open < lv)
    bool ambiguous = not fromAbove and not fromBelow
    [fromAbove or ambiguous, fromBelow or ambiguous]

//========================== DONNEES INTRABAR (1 minute) ==========================
ltf = timeframe.in_seconds() < 60 ? timeframe.period : "1"
[iO, iH, iL, iC, iV] = request.security_lower_tf(syminfo.tickerid, ltf, [open, high, low, close, volume])

//========================== PREVIOUS DAILY HIGH / LOW ==========================
// Extremes de la derniere journee close (cibles TP potentielles)
float pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
float pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead = barmerge.lookahead_on)

//========================== SESSION (jour du graphique) ==========================
var array<float> sHi = array.new_float()
var array<float> sLo = array.new_float()
var array<float> sVo = array.new_float()
var int   d_start        = na
var int   sess_start_bar = na
var float sesLo   = na
var float sesHi   = na

dayChg = ta.change(time("D"))
bool new_sess = na(time[1]) or nz(dayChg, 0) != 0

//========================== VA AU TICK (barre par barre) ==========================
var array<float> gDiff = array.new_float(20002, 0.)
var array<float> gTot  = array.new_float(20001, 0.)

f_sessionVA() =>
    float _vah = na
    float _val = na
    float _poc = na
    int n = array.size(sVo)
    if n > 0 and not na(sesLo) and not na(sesHi) and sesHi > sesLo
        float rng   = sesHi - sesLo
        int   kmult = math.max(calc_ticks, int(math.ceil(rng / (syminfo.mintick * 2000))))
        float fstep = syminfo.mintick * kmult
        int   fnum  = int(math.ceil(rng / fstep)) + 1
        if fnum > 20000
            fnum  := 20000
            fstep := rng / 20000
        array.fill(gDiff, 0.0, 0, fnum + 2)
        for k = 0 to n - 1
            float bh = array.get(sHi, k)
            float bl = array.get(sLo, k)
            float vv = array.get(sVo, k)
            if vv > 0
                int j0 = math.min(fnum - 1, math.max(0, int(math.floor((bl - sesLo) / fstep))))
                int j1 = math.min(fnum - 1, math.max(0, int(math.floor((bh - sesLo) / fstep))))
                if bh - bl <= 0 or j1 == j0
                    array.set(gDiff, j0,     array.get(gDiff, j0)     + vv)
                    array.set(gDiff, j0 + 1, array.get(gDiff, j0 + 1) - vv)
                else
                    float dens = vv / (bh - bl)
                    float e0   = dens * math.max(sesLo + (j0 + 1) * fstep - bl, 0)
                    float e1   = dens * math.max(bh - (sesLo + j1 * fstep), 0)
                    array.set(gDiff, j0,     array.get(gDiff, j0)     + e0)
                    array.set(gDiff, j0 + 1, array.get(gDiff, j0 + 1) - e0)
                    array.set(gDiff, j1,     array.get(gDiff, j1)     + e1)
                    array.set(gDiff, j1 + 1, array.get(gDiff, j1 + 1) - e1)
                    if j1 - j0 >= 2
                        float dfull = dens * fstep
                        array.set(gDiff, j0 + 1, array.get(gDiff, j0 + 1) + dfull)
                        array.set(gDiff, j1,     array.get(gDiff, j1)     - dfull)
        float run = 0.
        float tot = 0.
        int   poc = 0
        float mxv = -1.
        for j = 0 to fnum - 1
            run += array.get(gDiff, j)
            array.set(gTot, j, run)
            tot += run
            if run > mxv
                mxv := run
                poc := j
        float target = tot * percent / 100.
        float acc = array.get(gTot, poc)
        int u = poc
        int d = poc
        while acc < target and (u < fnum - 1 or d > 0)
            float uv = u < fnum - 1 ? array.get(gTot, u + 1) : 0.
            float lv = d > 0        ? array.get(gTot, d - 1) : 0.
            if d <= 0 or (u < fnum - 1 and uv >= lv)
                acc += uv
                u += 1
            else
                acc += lv
                d -= 1
        if tot > 0
            _vah := math.round_to_mintick(sesLo + fstep * u)
            _val := math.round_to_mintick(sesLo + fstep * d)
            _poc := math.round_to_mintick(sesLo + fstep * poc)
    [_vah, _val, _poc]

//========================== ETAT DES NIVEAUX SVP ==========================
// VA evolutive (barre par barre) de la seance EN COURS
var float shVah = na
var float shVal = na
var float shPoc = na
bool vaNow = false

var line  liveVah   = na
var line  liveVal   = na
var float liveVahLv = na
var float liveValLv = na
var int   liveVahTouch = na
var int   liveValTouch = na

var array<line>  oldVah  = array.new<line>()
var array<line>  oldVal  = array.new<line>()
var array<float> oldVahL = array.new_float()
var array<float> oldValL = array.new_float()
var array<bool>  oldVahF = array.new_bool()
var array<bool>  oldValF = array.new_bool()

// Dernier bar de touche (pour ne compter en confluence que les touches fraiches)
var int liveVahLastT = -10
var int liveValLastT = -10
var int evoVahLastT  = -10
var int evoValLastT  = -10

color cVah = #2962ff
color cVal = #ff9800

//========================== BASCULE DE SEANCE ==========================
if new_sess
    if not na(liveVah)
        if not na(liveVahTouch)
            line.set_x2(liveVah, liveVahTouch)
        array.push(oldVah,  liveVah)
        array.push(oldVahL, liveVahLv)
        array.push(oldVahF, not na(liveVahTouch))
        if not na(liveValTouch)
            line.set_x2(liveVal, liveValTouch)
        array.push(oldVal,  liveVal)
        array.push(oldValL, liveValLv)
        array.push(oldValF, not na(liveValTouch))
    liveVah := na
    liveVal := na
    liveVahTouch := na
    liveValTouch := na
    liveVahLastT := -10
    liveValLastT := -10
    evoVahLastT  := -10
    evoValLastT  := -10

    if not na(shVah) and not na(sess_start_bar)
        liveVah   := line.new(sess_start_bar, shVah, bar_index, shVah, xloc=xloc.bar_index, color=color.new(cVah, 0), width=1)
        liveVal   := line.new(sess_start_bar, shVal, bar_index, shVal, xloc=xloc.bar_index, color=color.new(cVal, 0), width=1)
        liveVahLv := shVah
        liveValLv := shVal

    while array.size(oldVah) > keepSess
        line.delete(array.shift(oldVah))
        array.shift(oldVahL)
        array.shift(oldVahF)
    while array.size(oldVal) > keepSess
        line.delete(array.shift(oldVal))
        array.shift(oldValL)
        array.shift(oldValF)

    array.clear(sHi)
    array.clear(sLo)
    array.clear(sVo)
    d_start        := time
    sess_start_bar := bar_index
    sesLo := na
    sesHi := na
    shVah := na
    shVal := na
    shPoc := na

//========================== ACCUMULATION SESSION ==========================
if not na(d_start)
    int nib = array.size(iV)
    if nib > 0
        for k = 0 to nib - 1
            float h_ = array.get(iH, k)
            float l_ = array.get(iL, k)
            array.push(sHi, h_)
            array.push(sLo, l_)
            array.push(sVo, nz(array.get(iV, k)))
            sesLo := na(sesLo) ? l_ : math.min(sesLo, l_)
            sesHi := na(sesHi) ? h_ : math.max(sesHi, h_)
    else
        array.push(sHi, high)
        array.push(sLo, low)
        array.push(sVo, nz(volume))
        sesLo := na(sesLo) ? low  : math.min(sesLo, low)
        sesHi := na(sesHi) ? high : math.max(sesHi, high)

//========================== CALCUL VA EVOLUTIVE DE LA SEANCE ==========================
if not na(d_start)
    [w_vah, w_val, w_poc] = f_sessionVA()
    if not na(w_vah)
        vaNow := true
        shVah := w_vah
        shVal := w_val
        shPoc := w_poc

//========================== TOUCHES ACTIVATRICES : VAH/VAL EVOLUTIVES ==========================
// Le POC est affiche mais n'active rien.
if vaNow and useEvo
    if low <= shVah and high >= shVah
        [fa, fb] = f_touchDir(shVah)
        actBullTouch := actBullTouch or fa
        actBearTouch := actBearTouch or fb
        if bar_index > evoVahLastT + 1
            freshBull += fa ? 1 : 0
            freshBear += fb ? 1 : 0
        evoVahLastT := bar_index
    if low <= shVal and high >= shVal
        [fa, fb] = f_touchDir(shVal)
        actBullTouch := actBullTouch or fa
        actBearTouch := actBearTouch or fb
        if bar_index > evoValLastT + 1
            freshBull += fa ? 1 : 0
            freshBear += fb ? 1 : 0
        evoValLastT := bar_index

//========================== EXTENSION / COUPURE + TOUCHES ACTIVATRICES SVP FIGE ==========================
// J-1 : prolonge jusqu'a la bougie courante, memorise la 1re touche sans couper.
if not na(liveVah)
    line.set_x2(liveVah, bar_index)
    if low <= liveVahLv and high >= liveVahLv
        if useJ1
            [fa, fb] = f_touchDir(liveVahLv)
            actBullTouch := actBullTouch or fa
            actBearTouch := actBearTouch or fb
            if bar_index > liveVahLastT + 1
                freshBull += fa ? 1 : 0
                freshBear += fb ? 1 : 0
        liveVahLastT := bar_index
        if na(liveVahTouch)
            liveVahTouch := bar_index
if not na(liveVal)
    line.set_x2(liveVal, bar_index)
    if low <= liveValLv and high >= liveValLv
        if useJ1
            [fa, fb] = f_touchDir(liveValLv)
            actBullTouch := actBullTouch or fa
            actBearTouch := actBearTouch or fb
            if bar_index > liveValLastT + 1
                freshBull += fa ? 1 : 0
                freshBear += fb ? 1 : 0
        liveValLastT := bar_index
        if na(liveValTouch)
            liveValTouch := bar_index

// J-2 et plus ancien : tant que non fige, on prolonge ; a la 1re touche on fige
// (touche forcement fraiche puisque premiere).
if array.size(oldVah) > 0
    for i = 0 to array.size(oldVah) - 1
        if not array.get(oldVahF, i)
            line.set_x2(array.get(oldVah, i), bar_index)
            float lv = array.get(oldVahL, i)
            if low <= lv and high >= lv
                array.set(oldVahF, i, true)
                if useUntouched
                    [fa, fb] = f_touchDir(lv)
                    actBullTouch := actBullTouch or fa
                    actBearTouch := actBearTouch or fb
                    freshBull += fa ? 1 : 0
                    freshBear += fb ? 1 : 0
if array.size(oldVal) > 0
    for i = 0 to array.size(oldVal) - 1
        if not array.get(oldValF, i)
            line.set_x2(array.get(oldVal, i), bar_index)
            float lv = array.get(oldValL, i)
            if low <= lv and high >= lv
                array.set(oldValF, i, true)
                if useUntouched
                    [fa, fb] = f_touchDir(lv)
                    actBullTouch := actBullTouch or fa
                    actBearTouch := actBearTouch or fb
                    freshBull += fa ? 1 : 0
                    freshBear += fb ? 1 : 0

//========================== NIVEAUX D'OUVERTURE HORAIRES (CONFLUENCE) ==========================
tzEff = tz == "Exchange" ? syminfo.timezone : tz

hlStyle = lineStyleIn == "Plein" ? line.style_solid : lineStyleIn == "Tirets" ? line.style_dashed : line.style_dotted
hlLabelSize = labelSizeIn == "Minuscule" ? size.tiny : labelSizeIn == "Normal" ? size.normal : size.small

msPerDay = 86400000
withinHistory = (timenow - time) <= histDays * msPerDay

f_endOfDay() =>
    y = year(time, tzEff)
    m = month(time, tzEff)
    d = dayofmonth(time, tzEff)
    timestamp(tzEff, y, m, d, 0, 0, 0) + msPerDay

f_crossTime(hh, mm) =>
    tgt = hh * 60 + mm
    cur = hour(time, tzEff) * 60 + minute(time, tzEff)
    prevT = nz(time[1], time - 1)
    newDay = dayofmonth(prevT, tzEff) != dayofmonth(time, tzEff)
    prev = newDay ? -1 : hour(prevT, tzEff) * 60 + minute(prevT, tzEff)
    cur >= tgt and prev < tgt

// Trace le niveau d'un horaire donne ; renvoie la touche directionnelle
// FRAICHE du bar courant : [par le haut (bull), par le bas (bear)]
f_level(enabled, hh, mm, col, txt) =>
    var line  ln = na
    var label lb = na
    var float lv = na
    var int   endT = na
    var int   bornBar = na
    var int   lastT = -10
    var bool  touched = false
    bool tb = false
    bool ts = false
    if enabled and withinHistory and f_crossTime(hh, mm)
        endT := f_endOfDay()
        ln := line.new(time, open, extendRight ? time + 1 : endT, open, xloc=xloc.bar_time, color=col, style=hlStyle, width=lineWidth, extend=extendRight ? extend.right : extend.none)
        lv := open
        bornBar := bar_index
        lastT := -10
        touched := false
        if showLabels
            lbTxt = showPrice ? txt + "  " + str.tostring(open, format.mintick) : txt
            lb := label.new(time, open, lbTxt, xloc=xloc.bar_time, style=label.style_label_left, textcolor=col, color=color.new(color.black, 100), size=hlLabelSize)
    bool active = not na(lv) and (extendRight or na(endT) or time < endT)
    if active and bar_index != bornBar and low <= lv and high >= lv
        if (not hlFirstTouchOnly or not touched) and bar_index > lastT + 1
            [fa, fb] = f_touchDir(lv)
            tb := fa
            ts := fb
        lastT := bar_index
        touched := true
    if not na(lb) and not na(ln) and barstate.islast and extendRight
        label.set_x(lb, time)
    float lvAct = active ? lv : na
    [tb, ts, lvAct]

[tb00, ts00, hlv00]       = f_level(show00,   0,  0, col00,   "00:00")
[tb06, ts06, hlv06]       = f_level(show06,   6,  0, col06,   "06:00")
[tb09, ts09, hlv09]       = f_level(show09,   9,  0, col09,   "09:00")
[tb10, ts10, hlv10]       = f_level(show10,  10,  0, col10,   "10:00")
[tb1530, ts1530, hlv1530] = f_level(show1530, 15, 30, col1530, "15:30")
[tb22, ts22, hlv22]       = f_level(show22,  22,  0, col22,   "22:00")

// Les niveaux horaires n'ACTIVENT pas : ils ajoutent uniquement de la confluence.
if useHourly
    freshBull += (tb00 ? 1 : 0) + (tb06 ? 1 : 0) + (tb09 ? 1 : 0) + (tb10 ? 1 : 0) + (tb1530 ? 1 : 0) + (tb22 ? 1 : 0)
    freshBear += (ts00 ? 1 : 0) + (ts06 ? 1 : 0) + (ts09 ? 1 : 0) + (ts10 ? 1 : 0) + (ts1530 ? 1 : 0) + (ts22 ? 1 : 0)

//========================== SIGNAUX DE RETOURNEMENT ==========================
bullFlip = haClose > haOpen and haClose[1] <= haOpen[1]
bearFlip = haClose < haOpen and haClose[1] >= haOpen[1]

momTurnUp   = nz(val) > nz(val[1])
momTurnDown = nz(val) < nz(val[1])

cameFromDown = minExtreme == 0 or ta.lowest(normVal, extremeLookback)  <= -minExtreme
cameFromUp   = minExtreme == 0 or ta.highest(normVal, extremeLookback) >=  minExtreme

// Validation : au moins un ACTIVATEUR touche dans la fenetre, dans le bon sens.
bool anyActTouch = actBullTouch or actBearTouch
int sinceBull = ta.barssince(dirTouch ? actBullTouch : anyActTouch)
int sinceBear = ta.barssince(dirTouch ? actBearTouch : anyActTouch)

bool zoneOKBull = not useZoneFilter or (not na(sinceBull) and sinceBull <= validBars)
bool zoneOKBear = not useZoneFilter or (not na(sinceBear) and sinceBear <= validBars)

// Filtre horaire : le signal ne s'affiche que dans la plage (ex. 15:30-00:00).
// Les touches de niveaux, elles, sont detectees toute la journee : il n'y a
// pas d'ordre chronologique impose entre niveaux horaires et activateurs.
bool inSigWindow = not na(time(timeframe.period, sigSession, tzEff))
bool timeOK = not useTimeFilter or inSigWindow

bullSignal = showSignals and timeOK and bullFlip and (not needMomentum or momTurnUp)   and cameFromDown and zoneOKBull
bearSignal = showSignals and timeOK and bearFlip and (not needMomentum or momTurnDown) and cameFromUp   and zoneOKBear

//========================== CONFLUENCE -> COULEUR DES POINTS ==========================
// Nombre de niveaux touches (activateurs + horaires) dans la fenetre de validite.
float confBull = math.sum(freshBull * 1.0, validBars + 1)
float confBear = math.sum(freshBear * 1.0, validBars + 1)
if not dirTouch
    confBull := confBull + confBear
    confBear := confBull

// 1 niveau = couleur claire ; confMax niveaux ou plus = couleur foncee.
float gradBull = math.min(math.max(nz(confBull), 1), confMax)
float gradBear = math.min(math.max(nz(confBear), 1), confMax)

color bullCol = color.from_gradient(gradBull, 1, confMax, #a5d6a7, #1b5e20)
color bearCol = color.from_gradient(gradBear, 1, confMax, #ef9a9a, #b71c1c)

//========================== ENTREE / SL / TP ==========================
// SL : plus bas (achat) ou plus haut (vente) des 'slLen' dernieres bougies.
float slLow  = ta.lowest(low, slLen)
float slHigh = ta.highest(high, slLen)

// TP : UNIQUEMENT les zones VAH/VAL du SVP fige et les extremes de la veille :
//   - VAH/VAL de la veille (J-1)
//   - zones SVP anciennes encore actives (jamais touchees)
//   - PDH / PDL (plus haut / plus bas de la veille)
// Ni plus ni moins : les niveaux horaires et la VAH/VAL/POC evolutive
// ne sont PAS des cibles.
// La cible retenue est LE NIVEAU LE PLUS PROCHE dans le sens du trade.
f_nearest(float best, float cand, float ent, int dir) =>
    float r = best
    if not na(cand) and ((dir == 1 and cand > ent) or (dir == -1 and cand < ent))
        if na(r) or math.abs(cand - ent) < math.abs(r - ent)
            r := cand
    r

f_findTP(float ent, int dir) =>
    float tp = na
    tp := f_nearest(tp, liveVahLv, ent, dir)
    tp := f_nearest(tp, liveValLv, ent, dir)
    if array.size(oldVahL) > 0
        for i = 0 to array.size(oldVahL) - 1
            if not array.get(oldVahF, i)
                tp := f_nearest(tp, array.get(oldVahL, i), ent, dir)
    if array.size(oldValL) > 0
        for i = 0 to array.size(oldValL) - 1
            if not array.get(oldValF, i)
                tp := f_nearest(tp, array.get(oldValL, i), ent, dir)
    tp := f_nearest(tp, pdh, ent, dir)
    tp := f_nearest(tp, pdl, ent, dir)
    tp

//========================== TRADE UNIQUE : OUVERTURE, SUIVI, CLOTURE EN R ==========================
// Regle : tant que le trade en cours n'a pas atteint son TP ou son SL,
// AUCUN nouveau signal n'est affiche. A la cloture, le resultat s'affiche
// en R : -1 R sur SL ; +RR sur TP (taille du TP rapportee a celle du SL).
// Les box des trades clotures restent a l'ecran (limite TradingView :
// 500 box au total, les plus anciennes sont alors retirees par la plateforme).
var int   trDir      = 0      // 0 = pas de trade en cours
var float trEnt      = na
var float trSl       = na
var float trTp       = na
var int   trStartBar = na
var box   trBoxSl    = na
var box   trBoxTp    = na
var line  trLine     = na

// ATR pour la distance max du TP (calcule a chaque barre, hors fonction)
float atrTrade = ta.atr(14)

// 1) suivi du trade actif : extension des box, detection TP / SL
if trDir != 0
    box.set_right(trBoxSl, bar_index)
    box.set_right(trBoxTp, bar_index)
    line.set_x2(trLine, bar_index)
    if bar_index > trStartBar
        bool slHit = trDir == 1 ? low <= trSl : high >= trSl
        bool tpHit = trDir == 1 ? high >= trTp : low <= trTp
        if slHit or tpHit
            // si TP et SL sont touches dans la meme bougie, le SL prime (conservateur)
            bool isSl = slHit
            float rr  = math.abs(trTp - trEnt) / math.max(math.abs(trEnt - trSl), syminfo.mintick)
            float res = isSl ? -1.0 : rr
            float px  = isSl ? trSl : trTp
            bool belowBar = (trDir == 1 and isSl) or (trDir == -1 and not isSl)
            label.new(bar_index, px, (res >= 0 ? "+" : "") + str.tostring(res, "#.##") + " R", color = isSl ? color.new(color.red, 0) : color.new(color.green, 0), textcolor = color.white, style = belowBar ? label.style_label_up : label.style_label_down, size = size.small)
            trDir := 0

// 2) nouveaux signaux : uniquement s'il n'y a pas de trade en cours
bool sigBull = bullSignal and (not showTrade or trDir == 0)
bool sigBear = bearSignal and (not showTrade or trDir == 0)

// 3) ouverture d'un nouveau trade sur le signal retenu
int openDir = showTrade and sigBull ? 1 : showTrade and sigBear ? -1 : 0
if openDir != 0
    float ent = close
    float sl  = openDir == 1 ? slLow : slHigh
    float tp  = f_findTP(ent, openDir)
    float risk = math.abs(ent - sl)
    // niveau trop lointain -> ignore (option)
    if not na(tp) and maxTPatr > 0 and math.abs(tp - ent) > maxTPatr * atrTrade
        tp := na
    // aucun niveau dans le sens du trade -> TP de secours a RR fixe,
    // pour que la box TP soit TOUJOURS affichee
    bool tpIsLevel = not na(tp)
    if not tpIsLevel and risk > 0
        tp := openDir == 1 ? ent + fallbackRR * risk : ent - fallbackRR * risk
    if not na(tp) and risk > 0
        trDir      := openDir
        trEnt      := ent
        trSl       := sl
        trTp       := tp
        trStartBar := bar_index
        trBoxSl := box.new(bar_index, math.max(ent, sl), bar_index + 1, math.min(ent, sl), bgcolor = slCol, border_color = color.new(slCol, 0), text = "SL " + str.tostring(sl, format.mintick), text_color = color.new(slCol, 0), text_size = size.tiny, text_halign = text.align_center)
        trBoxTp := box.new(bar_index, math.max(ent, tp), bar_index + 1, math.min(ent, tp), bgcolor = tpCol, border_color = color.new(tpCol, 0), text = (tpIsLevel ? "TP " : "TP RR " + str.tostring(fallbackRR, "#.#") + " ") + str.tostring(tp, format.mintick), text_color = color.new(tpCol, 0), text_size = size.tiny, text_halign = text.align_center)
        trLine  := line.new(bar_index, ent, bar_index + 1, ent, color = entCol, width = 2)

//========================== AFFICHAGE ==========================
plotcandle(haOpen, haHigh, haLow, haClose, title = "Heiken Ashi", color = haColor, wickcolor = haColor, bordercolor = color.new(color.black, 40))

sqzColor = noSqz ? color.blue : sqzOn ? color.black : color.gray
plotshape(showSqzDots ? 0.0 : na, title = "Etat squeeze", style = shape.circle, location = location.belowbar, color = sqzColor, size = size.tiny)

plotshape(sigBull, title = "Retournement haussier (zone)", style = shape.circle, location = location.belowbar, color = bullCol, size = size.small)
plotshape(sigBear, title = "Retournement baissier (zone)", style = shape.circle, location = location.abovebar, color = bearCol, size = size.small)

// VAH / VAL / POC evolutifs de la seance en cours
plot(showEvo and vaNow ? shVah : na, "VAH evolutive", color=color.new(#2962ff, 0), style=plot.style_linebr, linewidth=1)
plot(showEvo and vaNow ? shVal : na, "VAL evolutive", color=color.new(#ff9800, 0), style=plot.style_linebr, linewidth=1)
plot(show_poc and vaNow ? shPoc : na, "POC evolutif",  color=color.new(#e91e63, 0), style=plot.style_linebr, linewidth=1)

// PDH / PDL (extremes de la veille, cibles TP potentielles)
plot(showPD ? pdh : na, "PDH", color=color.new(color.teal, 0),   style=plot.style_linebr, linewidth=1)
plot(showPD ? pdl : na, "PDL", color=color.new(color.maroon, 0), style=plot.style_linebr, linewidth=1)

//========================== ALERTES ==========================
alertcondition(sigBull, title = "Retournement haussier valide", message = "HA Zones : retournement haussier valide par un activateur sur {{ticker}} {{interval}}")
alertcondition(sigBear, title = "Retournement baissier valide", message = "HA Zones : retournement baissier valide par un activateur sur {{ticker}} {{interval}}")
