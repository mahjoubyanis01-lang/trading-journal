//@version=6
indicator("Heiken Ashi par degres + Signaux", shorttitle="HA Sig", overlay=true)

// =========================================================================
// INPUTS
// =========================================================================
grpSqz = "Squeeze Momentum (LazyBear)"
bbLength     = input.int(20, "BB Length", group = grpSqz)
bbMult       = input.float(2.0, "BB MultFactor", group = grpSqz)
kcLength     = input.int(20, "KC Length", group = grpSqz)
kcMult       = input.float(1.5, "KC MultFactor", group = grpSqz)
useTrueRange = input.bool(true, "Use TrueRange (KC)", group = grpSqz)

grpColor = "Coloration / Graduation"
normLen   = input.int(100, "Fenetre de normalisation du momentum", group = grpColor, tooltip = "Nombre de barres utilisees pour calibrer l'echelle de couleur sur l'amplitude recente du momentum")
dampAlpha = input.int(55, "Transparence en phase de ralentissement", group = grpColor, minval = 0, maxval = 100, tooltip = "0 = pas d'effet, 100 = quasi invisible quand le momentum ralentit")

grpSqzShow  = "Affichage squeeze"
showSqzDots = input.bool(true, "Afficher les points de squeeze sous les bougies", group = grpSqzShow)

grpSig = "Signaux de retournement (extremes de couleur)"
showSignals   = input.bool(true, "Afficher les signaux (point vert / point rouge)", group = grpSig)
extremeZone   = input.int(75, "Zone extreme requise (0-100)", group = grpSig, minval = 40, maxval = 100, tooltip = "Le momentum normalise doit avoir atteint au moins cette valeur avant le retournement : +75 et plus = bougies violet extreme (signal baissier a venir), -75 et moins = bougies rouge extreme (signal haussier a venir). Les basculements sans extreme prealable sont ignores.")
extremeLookback = input.int(12, "Barres de recherche de l'extreme", group = grpSig, minval = 1, tooltip = "Nombre de barres en arriere ou l'extreme de couleur doit avoir ete atteint")
fadeBars      = input.int(2, "Bougies d'essoufflement consecutives", group = grpSig, minval = 1, maxval = 10, tooltip = "Nombre de bougies consecutives ou le momentum reflue depuis l'extreme (val qui redescend apres un pic violet, val qui remonte apres un creux rouge) requis au moment du basculement HA. Confirme que l'extreme s'epuise vraiment au lieu d'une simple pause.")
pullbackPts   = input.int(15, "Repli minimal depuis l'extreme (points)", group = grpSig, minval = 0, maxval = 60, tooltip = "Sur l'echelle -100/+100 : le momentum doit s'etre eloigne d'au moins ce nombre de points de son extreme recent. Evite de signaler pendant que la couleur est encore saturee. 0 = desactive.")

// =========================================================================
// HEIKEN ASHI (OHLC)
// =========================================================================
haTicker = ticker.heikinashi(syminfo.tickerid)
haOpen   = request.security(haTicker, timeframe.period, open)
haHigh   = request.security(haTicker, timeframe.period, high)
haLow    = request.security(haTicker, timeframe.period, low)
haClose  = request.security(haTicker, timeframe.period, close)

// =========================================================================
// SQUEEZE MOMENTUM (LazyBear) -- recalcul en v6, sur le prix reel
// =========================================================================
source = close
basis  = ta.sma(source, bbLength)
dev    = bbMult * ta.stdev(source, bbLength)
upperBB = basis + dev
lowerBB = basis - dev

ma      = ta.sma(source, kcLength)
rangeV  = useTrueRange ? ta.tr(true) : (high - low)
rangema = ta.sma(rangeV, kcLength)
upperKC = ma + rangema * kcMult
lowerKC = ma - rangema * kcMult

sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)
noSqz  = not sqzOn and not sqzOff

val = ta.linreg(source - math.avg(math.avg(ta.highest(high, kcLength), ta.lowest(low, kcLength)), ta.sma(close, kcLength)), kcLength, 0)

// =========================================================================
// GRADUATION DE COULEUR (remplace le vert/rouge classique de HA)
// =========================================================================
// Normalisation du momentum sur son amplitude recente -> echelle -100 / +100
normVal = 100 * nz(val) / math.max(ta.highest(math.abs(val), normLen), 1e-10)
normVal := math.max(math.min(normVal, 100), -100)

// Le momentum se renforce dans son sens (equivalent du lime/red de l'original)
// ou faiblit en revenant vers zero (equivalent du green/maroon, plus terne)
strengthening = val > 0 ? (val > nz(val[1])) : (val < nz(val[1]))

baseColor = normVal >= 0 ?
     color.from_gradient(normVal, 0, 100, color.new(color.gray, 45), color.new(#cd00db, 0)) :
     color.from_gradient(normVal, -100, 0, color.new(color.red, 0), color.new(color.gray, 45))

haColor = strengthening ? baseColor : color.new(baseColor, dampAlpha)

// =========================================================================
// SIGNAUX DE RETOURNEMENT (bases uniquement sur cet indicateur)
// =========================================================================
// Observation : les retournements exploitables suivent les EXTREMES de
// couleur -- violet extreme (momentum normalise vers +100) avant un
// retournement baissier, rouge extreme (vers -100) avant un retournement
// haussier. Trois exigences cumulatives :
//   1. ZONE EXTREME : |normVal| a atteint au moins 'extremeZone' dans la
//      fenetre de recherche (le marche sort d'une couleur saturee).
//   2. ESSOUFFLEMENT : le momentum reflue depuis 'fadeBars' bougies
//      consecutives (pas une simple pause d'une bougie).
//   3. REPLI : le momentum s'est eloigne d'au moins 'pullbackPts' points
//      de son extreme recent (la couleur a vraiment commence a se vider).
// Le declencheur reste le basculement de la bougie Heiken Ashi.

// Basculement de la bougie Heiken Ashi : la direction lissee change de camp
bullFlip = haClose > haOpen and haClose[1] <= haOpen[1]
bearFlip = haClose < haOpen and haClose[1] >= haOpen[1]

// 1. Zone extreme atteinte recemment
float hiNorm = ta.highest(normVal, extremeLookback)
float loNorm = ta.lowest(normVal, extremeLookback)
bool fromPurpleExtreme = hiNorm >=  extremeZone    // violet extreme -> short possible
bool fromRedExtreme    = loNorm <= -extremeZone    // rouge extreme  -> long possible

// 2. Essoufflement consecutif du momentum
var int decCnt = 0
var int incCnt = 0
decCnt := nz(val) < nz(val[1]) ? decCnt + 1 : 0
incCnt := nz(val) > nz(val[1]) ? incCnt + 1 : 0

// 3. Repli mesurable depuis l'extreme
bool pulledFromPurple = pullbackPts == 0 or normVal <= hiNorm - pullbackPts
bool pulledFromRed    = pullbackPts == 0 or normVal >= loNorm + pullbackPts

// 4. ARMEMENT : un extreme = UN SEUL signal.
//    L'extreme arme le signal ; le signal le consomme. Il faut que le
//    momentum retourne en zone extreme pour re-armer. Supprime les
//    signaux en grappe et les re-tentatives sur un extreme deja joue.
var bool bullArmed = false
var bool bearArmed = false
if normVal <= -extremeZone
    bullArmed := true
if normVal >= extremeZone
    bearArmed := true

bullSignal = showSignals and bullFlip and bullArmed and fromRedExtreme    and incCnt >= fadeBars and pulledFromRed
bearSignal = showSignals and bearFlip and bearArmed and fromPurpleExtreme and decCnt >= fadeBars and pulledFromPurple

if bullSignal
    bullArmed := false
if bearSignal
    bearArmed := false

// =========================================================================
// AFFICHAGE
// =========================================================================
plotcandle(haOpen, haHigh, haLow, haClose, title = "Heiken Ashi", color = haColor, wickcolor = haColor, bordercolor = color.new(color.black, 40))

sqzColor = noSqz ? color.blue : sqzOn ? color.black : color.gray
plotshape(showSqzDots ? 0.0 : na, title = "Etat squeeze", style = shape.circle, location = location.belowbar, color = sqzColor, size = size.tiny)

// Point vert sous la bougie = retournement haussier ; point rouge au-dessus = retournement baissier
plotshape(bullSignal, title = "Retournement haussier", style = shape.circle, location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(bearSignal, title = "Retournement baissier", style = shape.circle, location = location.abovebar, color = color.new(color.red, 0),   size = size.small)

// =========================================================================
// ALERTES
// =========================================================================
alertcondition(bullSignal, title = "Retournement haussier", message = "HA Sig : retournement haussier apres rouge extreme (point vert) sur {{ticker}} {{interval}}")
alertcondition(bearSignal, title = "Retournement baissier", message = "HA Sig : retournement baissier apres violet extreme (point rouge) sur {{ticker}} {{interval}}")
