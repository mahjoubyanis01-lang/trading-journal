//@version=6
indicator("Heiken Ashi par degrès + Signaux", shorttitle="HA degrès + Signaux", overlay=true)

// =========================================================================
// INPUTS
// =========================================================================
grpSqz = "Squeeze Momentum (LazyBear)"
bbLength     = input.int(20, "BB Length", group = grpSqz)
bbMult       = input.float(2.0, "BB MultFactor", group = grpSqz)
kcLength     = input.int(20, "KC Length", group = grpSqz)
kcMult       = input.float(1.5, "KC MultFactor", group = grpSqz)
useTrueRange = input.bool(true, "Use TrueRange (KC)", group = grpSqz)

grpColor = "Coloration / Graduation"
normLen   = input.int(100, "Fenêtre de normalisation du momentum", group = grpColor, tooltip = "Nombre de barres utilisées pour calibrer l'échelle de couleur sur l'amplitude récente du momentum")
dampAlpha = input.int(55, "Transparence en phase de ralentissement", group = grpColor, minval = 0, maxval = 100, tooltip = "0 = pas d'effet, 100 = quasi invisible quand le momentum ralentit")

grpSqzShow  = "Affichage squeeze"
showSqzDots = input.bool(true, "Afficher les points de squeeze sous les bougies", group = grpSqzShow)

grpSig = "Signaux de retournement"
showSignals   = input.bool(true, "Afficher les signaux (point vert / point rouge)", group = grpSig)
needMomentum  = input.bool(true, "Exiger une inflexion du momentum", group = grpSig, tooltip = "Le point n'apparaît que si le momentum tourne dans le sens du retournement (val remonte pour un signal haussier, val redescend pour un signal baissier). Filtre les simples changements de couleur sans soutien du momentum.")
minExtreme    = input.int(30, "Extrême minimal avant retournement (0-100)", group = grpSig, minval = 0, maxval = 100, tooltip = "Le momentum normalisé doit avoir atteint au moins cette valeur dans le sens opposé sur les barres récentes avant le signal. 0 = désactivé : tout basculement de bougie HA est signalé. Plus la valeur est haute, plus on ne garde que les retournements après un mouvement marqué.")
extremeLookback = input.int(10, "Barres de recherche de l'extrême", group = grpSig, minval = 1, tooltip = "Nombre de barres en arrière où chercher l'extrême opposé exigé ci-dessus")

// =========================================================================
// HEIKEN ASHI (OHLC)
// =========================================================================
haTicker = ticker.heikinashi(syminfo.tickerid)
haOpen   = request.security(haTicker, timeframe.period, open)
haHigh   = request.security(haTicker, timeframe.period, high)
haLow    = request.security(haTicker, timeframe.period, low)
haClose  = request.security(haTicker, timeframe.period, close)

// =========================================================================
// SQUEEZE MOMENTUM (LazyBear) — recalcul en v6, sur le prix réel
// =========================================================================
source = close
basis  = ta.sma(source, bbLength)
dev    = bbMult * ta.stdev(source, bbLength)
upperBB = basis + dev
lowerBB = basis - dev

ma      = ta.sma(source, kcLength)
rangeV  = useTrueRange ? ta.tr(true) : (high - low)
rangema = ta.sma(rangeV, kcLength)
upperKC = ma + rangema * kcMult
lowerKC = ma - rangema * kcMult

sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)
noSqz  = not sqzOn and not sqzOff

val = ta.linreg(source - math.avg(math.avg(ta.highest(high, kcLength), ta.lowest(low, kcLength)), ta.sma(close, kcLength)), kcLength, 0)

// =========================================================================
// GRADUATION DE COULEUR (remplace le vert/rouge classique de HA)
// =========================================================================
// Normalisation du momentum sur son amplitude récente -> échelle -100 / +100
normVal = 100 * nz(val) / math.max(ta.highest(math.abs(val), normLen), 1e-10)
normVal := math.max(math.min(normVal, 100), -100)

// Le momentum "se renforce" dans son sens (équivalent du lime/red de l'original)
// ou "faiblit" en revenant vers zéro (équivalent du green/maroon, plus terne)
strengthening = val > 0 ? (val > nz(val[1])) : (val < nz(val[1]))

baseColor = normVal >= 0 ?
     color.from_gradient(normVal, 0, 100, color.new(color.gray, 45), color.new(#cd00db, 0)) :
     color.from_gradient(normVal, -100, 0, color.new(color.red, 0), color.new(color.gray, 45))

haColor = strengthening ? baseColor : color.new(baseColor, dampAlpha)

// =========================================================================
// SIGNAUX DE RETOURNEMENT (basés uniquement sur cet indicateur)
// =========================================================================
// Basculement de la bougie Heiken Ashi : la direction lissée change de camp
bullFlip = haClose > haOpen and haClose[1] <= haOpen[1]
bearFlip = haClose < haOpen and haClose[1] >= haOpen[1]

// Inflexion du momentum dans le sens du retournement
momTurnUp   = nz(val) > nz(val[1])
momTurnDown = nz(val) < nz(val[1])

// Le marché doit venir d'un mouvement marqué dans l'autre sens
// (extrême du momentum normalisé sur les barres récentes)
cameFromDown = minExtreme == 0 or ta.lowest(normVal, extremeLookback)  <= -minExtreme
cameFromUp   = minExtreme == 0 or ta.highest(normVal, extremeLookback) >=  minExtreme

bullSignal = showSignals and bullFlip and (not needMomentum or momTurnUp)   and cameFromDown
bearSignal = showSignals and bearFlip and (not needMomentum or momTurnDown) and cameFromUp

// =========================================================================
// AFFICHAGE
// =========================================================================
plotcandle(haOpen, haHigh, haLow, haClose, title = "Heiken Ashi", color = haColor, wickcolor = haColor, bordercolor = color.new(color.black, 40))

sqzColor = noSqz ? color.blue : sqzOn ? color.black : color.gray
plotshape(showSqzDots ? 0.0 : na, title = "État squeeze", style = shape.circle, location = location.belowbar, color = sqzColor, size = size.tiny)

// Point vert sous la bougie = retournement haussier ; point rouge au-dessus = retournement baissier
plotshape(bullSignal, title = "Retournement haussier", style = shape.circle, location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(bearSignal, title = "Retournement baissier", style = shape.circle, location = location.abovebar, color = color.new(color.red, 0),   size = size.small)

// =========================================================================
// ALERTES
// =========================================================================
alertcondition(bullSignal, title = "Retournement haussier", message = "HA degrès : retournement haussier (point vert) sur {{ticker}} {{interval}}")
alertcondition(bearSignal, title = "Retournement baissier", message = "HA degrès : retournement baissier (point rouge) sur {{ticker}} {{interval}}")
