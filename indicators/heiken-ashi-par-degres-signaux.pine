//@version=6
indicator("Heiken Ashi par degres + Signaux", shorttitle="HA Sig", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)

// =========================================================================
// INPUTS
// =========================================================================
grpSqz = "Squeeze Momentum (LazyBear)"
bbLength     = input.int(20, "BB Length", group = grpSqz)
bbMult       = input.float(2.0, "BB MultFactor", group = grpSqz)
kcLength     = input.int(20, "KC Length", group = grpSqz)
kcMult       = input.float(1.5, "KC MultFactor", group = grpSqz)
useTrueRange = input.bool(true, "Use TrueRange (KC)", group = grpSqz)

grpColor = "Coloration / Graduation"
normLen   = input.int(100, "Fenetre de normalisation du momentum", group = grpColor, tooltip = "Nombre de barres utilisees pour calibrer l'echelle de couleur sur l'amplitude recente du momentum")
dampAlpha = input.int(55, "Transparence en phase de ralentissement", group = grpColor, minval = 0, maxval = 100, tooltip = "0 = pas d'effet, 100 = quasi invisible quand le momentum ralentit")

grpSqzShow  = "Affichage squeeze"
showSqzDots = input.bool(true, "Afficher les points de squeeze sous les bougies", group = grpSqzShow)

grpSig = "Signaux : cassure de la bougie extreme"
showSignals  = input.bool(true, "Afficher les signaux (point vert / point rouge)", group = grpSig)
vividZone    = input.int(75, "Seuil de couleur vive (0-100)", group = grpSig, minval = 40, maxval = 100, tooltip = "Momentum normalise a partir duquel une bougie est consideree violet vif (+) ou rouge vif (-). C'est l'entree en cycle : la premiere bougie vive ouvre la surveillance.")
breakOnClose = input.bool(true, "Cassure a la cloture (sinon a la meche)", group = grpSig, tooltip = "Active : il faut une cloture au-dela du niveau de la bougie de reference. Desactive : une simple meche qui depasse suffit.")
showLevels   = input.bool(true, "Afficher le niveau surveille", group = grpSig, tooltip = "Ligne pointillee sur le niveau attendu : le plus bas de la bougie violette de reference, ou le plus haut de la bougie rouge de reference.")
showExitCross = input.bool(true, "Croix noire de perte de momentum", group = grpSig, tooltip = "Apres chaque signal, marque d'une croix noire la bougie ou la perte de momentum est confirmee : le prix peut potentiellement se retourner dans le sens inverse. Au-dessus de la bougie apres un achat, en dessous apres une vente. Une seule croix par signal.")
crossBars     = input.int(2, "Bougies de repli pour confirmer la croix", group = grpSig, minval = 1, maxval = 10, tooltip = "Nombre de bougies CONSECUTIVES de momentum a contre-sens du signal necessaires pour poser la croix. 1 = des le premier flechissement (bruyant). 2-3 = la perte d'elan est confirmee et le risque de retournement du prix est reel.")
maxWait      = input.int(0, "Validite du niveau (barres, 0 = illimitee)", group = grpSig, minval = 0, maxval = 500, tooltip = "Nombre de barres au-dela duquel un niveau non casse est abandonne.")

grpTrade = "Entree / SL (box) - sortie a la croix"
showTrade  = input.bool(true, "Afficher entree + box SL sur chaque signal", group = grpTrade, tooltip = "Un seul trade a la fois : tant qu'il n'est pas clos (SL, BE ou croix), aucun nouveau signal n'est affiche. Le trade cloture a la croix de perte de momentum, au prix de cloture de cette bougie, resultat affiche en R.")
slLen      = input.int(5, "Bougies pour le SL (plus bas / plus haut)", minval = 1, maxval = 50, group = grpTrade, tooltip = "Achat : SL = plus bas des N dernieres bougies. Vente : SL = plus haut des N dernieres bougies.")
slCol      = input.color(color.new(color.red, 80),  "Box SL", group = grpTrade, inline = "tc")
entCol     = input.color(color.new(color.gray, 0),  "Entree", group = grpTrade, inline = "tc")
useBE      = input.bool(true, "Break-even : SL ramene a l'entree des +1 R", group = grpTrade, tooltip = "Des que le gain latent atteint le seuil (en R), le stop passe a l'entree. Un retour sur l'entree cloture alors le trade a 0 R (BE) au lieu de -1 R.")
beTrigger  = input.float(1.0, "Declenchement du break-even (en R)", minval = 0.1, step = 0.25, group = grpTrade)

grpDash = "Tableau de bord"
showDash   = input.bool(true, "Afficher le tableau de bord", group = grpDash)
dashPosIn  = input.string("Haut droite", "Position", options = ["Haut droite", "Haut gauche", "Bas droite", "Bas gauche"], group = grpDash)
dashSizeIn = input.string("Petit", "Taille du texte", options = ["Minuscule", "Petit", "Normal"], group = grpDash)

// =========================================================================
// HEIKEN ASHI (OHLC)
// =========================================================================
haTicker = ticker.heikinashi(syminfo.tickerid)
haOpen   = request.security(haTicker, timeframe.period, open)
haHigh   = request.security(haTicker, timeframe.period, high)
haLow    = request.security(haTicker, timeframe.period, low)
haClose  = request.security(haTicker, timeframe.period, close)

// =========================================================================
// SQUEEZE MOMENTUM (LazyBear) -- recalcul en v6, sur le prix reel
// =========================================================================
source = close
basis  = ta.sma(source, bbLength)
dev    = bbMult * ta.stdev(source, bbLength)
upperBB = basis + dev
lowerBB = basis - dev

ma      = ta.sma(source, kcLength)
rangeV  = useTrueRange ? ta.tr(true) : (high - low)
rangema = ta.sma(rangeV, kcLength)
upperKC = ma + rangema * kcMult
lowerKC = ma - rangema * kcMult

sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)
noSqz  = not sqzOn and not sqzOff

val = ta.linreg(source - math.avg(math.avg(ta.highest(high, kcLength), ta.lowest(low, kcLength)), ta.sma(close, kcLength)), kcLength, 0)

// =========================================================================
// GRADUATION DE COULEUR (remplace le vert/rouge classique de HA)
// =========================================================================
// Normalisation du momentum sur son amplitude recente -> echelle -100 / +100
normVal = 100 * nz(val) / math.max(ta.highest(math.abs(val), normLen), 1e-10)
normVal := math.max(math.min(normVal, 100), -100)

// Le momentum se renforce dans son sens (equivalent du lime/red de l'original)
// ou faiblit en revenant vers zero (equivalent du green/maroon, plus terne)
strengthening = val > 0 ? (val > nz(val[1])) : (val < nz(val[1]))

baseColor = normVal >= 0 ?
     color.from_gradient(normVal, 0, 100, color.new(color.gray, 45), color.new(#cd00db, 0)) :
     color.from_gradient(normVal, -100, 0, color.new(color.red, 0), color.new(color.gray, 45))

haColor = strengthening ? baseColor : color.new(baseColor, dampAlpha)

// =========================================================================
// SIGNAUX : CASSURE DE LA BOUGIE EXTREME
// =========================================================================
// Quand la couleur devient VIVE (violet vif = normVal >= seuil, rouge vif
// = normVal <= -seuil), un cycle s'ouvre sur la premiere bougie vive.
//  - Cycle VIOLET : parmi les bougies violet vif depuis la premiere du
//    cycle, on retient celle qui a fait LE PLUS HAUT ; sa reference est
//    son plus haut et son plus bas (meche et corps compris).
//    SIGNAL BAISSIER = cassure de SON PLUS BAS.
//  - Cycle ROUGE : la bougie rouge vif ayant fait LE PLUS BAS depuis la
//    premiere rouge vive du cycle.
//    SIGNAL HAUSSIER = cassure de SON PLUS HAUT.
// Un signal clot le cycle ; un passage a la couleur vive opposee bascule
// le cycle (l'ancien niveau est abandonne).

// Une bougie est VIVE seulement si sa couleur est PLEINE, pas terne :
// zone extreme atteinte ET momentum qui se renforce (strengthening).
// Une bougie violette ou rouge mais assombrie/transparente (momentum qui
// decelere, effet dampAlpha) n'est PAS vive : elle ne peut ni ouvrir un
// cycle, ni devenir la bougie de reference, ni remettre a zero le
// compteur de cycle perdu.
bool vividUp = normVal >=  vividZone and strengthening    // violet vif (couleur pleine)
bool vividDn = normVal <= -vividZone and strengthening    // rouge vif (couleur pleine)

var int   epDir  = 0    // 1 = cycle violet (attend cassure du bas), -1 = cycle rouge (attend cassure du haut)
var float refHi  = na   // extremes de la bougie de reference
var float refLo  = na
var int   refBar = na
var line  refLn  = na

// Ouverture / bascule de cycle sur la premiere bougie vive
if vividUp and epDir != 1
    epDir  := 1
    refHi  := na
    refLo  := na
    refBar := na
    if not na(refLn)
        line.delete(refLn)
    refLn := na
if vividDn and epDir != -1
    epDir  := -1
    refHi  := na
    refLo  := na
    refBar := na
    if not na(refLn)
        line.delete(refLn)
    refLn := na

// Pose / mise a jour de la bougie de reference : une bougie VIVE faisant
// un nouvel extreme du cycle (plus haut pour le violet, plus bas pour le
// rouge), meche et corps compris.
if epDir == 1 and vividUp and (na(refHi) or haHigh > refHi)
    refHi  := haHigh
    refLo  := haLow
    refBar := bar_index
    if na(refLn)
        refLn := showLevels ? line.new(bar_index, refLo, bar_index + 1, refLo, color = color.new(#cd00db, 0), style = line.style_dashed, width = 2) : na
    else
        line.set_xy1(refLn, bar_index, refLo)
        line.set_xy2(refLn, bar_index + 1, refLo)
if epDir == -1 and vividDn and (na(refLo) or haLow < refLo)
    refHi  := haHigh
    refLo  := haLow
    refBar := bar_index
    if na(refLn)
        refLn := showLevels ? line.new(bar_index, refHi, bar_index + 1, refHi, color = color.new(color.red, 0), style = line.style_dashed, width = 2) : na
    else
        line.set_xy1(refLn, bar_index, refHi)
        line.set_xy2(refLn, bar_index + 1, refHi)

// Extension du niveau surveille jusqu'a la bougie courante
if epDir != 0 and not na(refLn)
    line.set_x2(refLn, bar_index)

// Expiration optionnelle d'un niveau jamais casse
if epDir != 0 and not na(refBar) and maxWait > 0 and bar_index - refBar > maxWait
    epDir := 0
    refLn := na   // la ligne reste a l'ecran, figee

// Cassure de la reference -> signal (et cloture du cycle)
bool brkDn = epDir == 1  and not na(refLo) and bar_index > refBar and (breakOnClose ? haClose < refLo : haLow  < refLo)
bool brkUp = epDir == -1 and not na(refHi) and bar_index > refBar and (breakOnClose ? haClose > refHi : haHigh > refHi)

bearSignal = showSignals and brkDn
bullSignal = showSignals and brkUp

if brkDn or brkUp
    epDir := 0
    refLn := na   // la ligne reste figee a l'endroit de la cassure

// =========================================================================
// CROIX DE PERTE DE MOMENTUM (une par signal)
// =========================================================================
// But : signaler quand le prix peut POTENTIELLEMENT se retourner dans le
// sens inverse du signal. Pour eviter le bruit d'un simple flechissement
// d'une bougie, la croix exige 'crossBars' bougies CONSECUTIVES de
// momentum a contre-sens :
//  - apres un ACHAT : 'crossBars' bougies de momentum en baisse
//    -> croix noire AU-DESSUS de la bougie de confirmation ;
//  - apres une VENTE : 'crossBars' bougies de momentum en hausse
//    -> croix noire EN DESSOUS de la bougie de confirmation.
var int momDnCnt = 0
var int momUpCnt = 0
momDnCnt := nz(val) < nz(val[1]) ? momDnCnt + 1 : 0
momUpCnt := nz(val) > nz(val[1]) ? momUpCnt + 1 : 0

// La croix n'est VALIDE que si le PNL est POSITIF : le prix doit etre
// au-dela du prix du signal dans le sens du trade. Si le momentum
// s'essouffle en perte, pas de croix -- le trade attend le SL ou un
// retour en profit avec l'essoufflement toujours present.
var int   pendingExit = 0    // 1 = achat en attente de croix, -1 = vente, 0 = rien
var int   sigBarIdx   = na
var float sigPrice    = na   // prix d'entree de reference (cloture du signal)
bool exitAfterBull = false
bool exitAfterBear = false
if pendingExit == 1 and not na(sigBarIdx) and bar_index > sigBarIdx and momDnCnt >= crossBars and close > sigPrice
    exitAfterBull := true
    pendingExit := 0
if pendingExit == -1 and not na(sigBarIdx) and bar_index > sigBarIdx and momUpCnt >= crossBars and close < sigPrice
    exitAfterBear := true
    pendingExit := 0
// =========================================================================
// TRADE UNIQUE : ENTREE / BOX SL, SORTIE A LA CROIX
// =========================================================================
// Gestion identique a l'indicateur HA Zones pour le risque :
//  - SL initial = plus bas (achat) / plus haut (vente) des 'slLen'
//    dernieres bougies ; -1 R s'il est touche
//  - break-even a +1 R : stop ramene a l'entree, cloture a 0 R (BE)
// Mais PAS de TP fixe : le trade CLOTURE A LA CROIX de perte de momentum,
// au prix de cloture de la bougie de croix, resultat affiche en R
// (positif ou negatif selon ou en est le prix par rapport a l'entree).
// Tant que le trade est ouvert, aucun nouveau signal n'est affiche.
float slLow  = ta.lowest(low, slLen)
float slHigh = ta.highest(high, slLen)

var int   trDir      = 0      // 0 = pas de trade en cours
var float trEnt      = na
var float trSl       = na
var int   trStartBar = na
var bool  trBE       = false
var box   trBoxSl    = na
var line  trLine     = na
var line  trBeLine   = na

// Resultat du trade clos sur cette bougie (na = aucun), pour les stats
float tradeRes = na

// 1) suivi du trade actif : extension, stop (initial ou BE), sortie croix
if trDir != 0
    box.set_right(trBoxSl, bar_index)
    line.set_x2(trLine, bar_index)
    if not na(trBeLine)
        line.set_x2(trBeLine, bar_index)
    if bar_index > trStartBar
        float risk0 = math.max(math.abs(trEnt - trSl), syminfo.mintick)
        float slLevel = trBE ? trEnt : trSl
        bool slHit = trDir == 1 ? low <= slLevel : high >= slLevel
        bool crossExit = trDir == 1 ? exitAfterBull : exitAfterBear
        if slHit
            // stop prioritaire (conservateur) : -1 R, ou 0 R si break-even
            string resTxt = trBE ? "BE 0 R" : "-1 R"
            color  resCol = trBE ? color.new(color.gray, 0) : color.new(color.red, 0)
            label.new(bar_index, slLevel, resTxt, color = resCol, textcolor = color.white, style = trDir == 1 ? label.style_label_up : label.style_label_down, size = size.small)
            tradeRes := trBE ? 0.0 : -1.0
            trDir := 0
            // economie d'objets : l'entree reste visible comme bord de la
            // box SL ; les lignes du trade clos sont liberees pour que
            // l'affichage couvre plus de jours (limite TradingView : 500)
            line.delete(trLine)
            trLine := na
            if not na(trBeLine)
                line.delete(trBeLine)
                trBeLine := na
        else if crossExit
            // sortie a la croix : resultat au prix de cloture de la bougie
            float res = trDir * (close - trEnt) / risk0
            string resTxt = (res >= 0 ? "+" : "") + str.tostring(res, "#.##") + " R"
            color  resCol = res > 0.01 ? color.new(color.green, 0) : res < -0.01 ? color.new(color.red, 0) : color.new(color.gray, 0)
            label.new(bar_index, close, resTxt, color = resCol, textcolor = color.white, style = label.style_label_left, size = size.small)
            tradeRes := res
            trDir := 0
            line.delete(trLine)
            trLine := na
            if not na(trBeLine)
                line.delete(trBeLine)
                trBeLine := na
        else if useBE and not trBE
            bool beNow = trDir == 1 ? high >= trEnt + beTrigger * risk0 : low <= trEnt - beTrigger * risk0
            if beNow
                trBE := true
                trBeLine := line.new(bar_index, trEnt, bar_index + 1, trEnt, color = color.new(color.orange, 0), width = 2, style = line.style_dashed)
                label.new(bar_index, trEnt, "BE", color = color.new(color.orange, 0), textcolor = color.white, style = trDir == 1 ? label.style_label_down : label.style_label_up, size = size.tiny)

// Statistiques de backtest en R (courbe d'equite : BE = 0, SL = -1,
// croix = +R ; le drawdown est mesure pic-a-creux sur cette courbe,
// donc perte + BE + perte = -2 R de drawdown)
var int   btN      = 0
var int   btWin    = 0
var int   btLoss   = 0
var int   btBE     = 0
var float btSum    = 0.0
var float btGrossW = 0.0
var float btGrossL = 0.0
var float btPeak   = 0.0
var float btDdMax  = 0.0
if not na(tradeRes)
    btN   += 1
    btSum += tradeRes
    if tradeRes > 0.01
        btWin += 1
        btGrossW += tradeRes
    else if tradeRes < -0.01
        btLoss += 1
        btGrossL += -tradeRes
    else
        btBE += 1
    btPeak  := math.max(btPeak, btSum)
    btDdMax := math.max(btDdMax, btPeak - btSum)
float btDdCur = btPeak - btSum

// 2) nouveaux signaux : uniquement s'il n'y a pas de trade en cours
bool sigBull = bullSignal and (not showTrade or trDir == 0)
bool sigBear = bearSignal and (not showTrade or trDir == 0)

// 3) ouverture du trade sur le signal affiche
int openDir = showTrade and sigBull ? 1 : showTrade and sigBear ? -1 : 0
if openDir != 0
    float ent = close
    float sl  = openDir == 1 ? slLow : slHigh
    if math.abs(ent - sl) > 0
        trDir      := openDir
        trEnt      := ent
        trSl       := sl
        trStartBar := bar_index
        trBE       := false
        trBeLine   := na
        trBoxSl := box.new(bar_index, math.max(ent, sl), bar_index + 1, math.min(ent, sl), bgcolor = slCol, border_color = color.new(slCol, 0), text = "SL " + str.tostring(sl, format.mintick), text_color = color.new(slCol, 0), text_size = size.tiny, text_halign = text.align_center)
        trLine  := line.new(bar_index, ent, bar_index + 1, ent, color = entCol, width = 2)

// 4) armement de la croix sur le signal effectivement affiche
if sigBull
    pendingExit := 1
    sigBarIdx := bar_index
    sigPrice := close
if sigBear
    pendingExit := -1
    sigBarIdx := bar_index
    sigPrice := close

// =========================================================================
// AFFICHAGE
// =========================================================================
plotcandle(haOpen, haHigh, haLow, haClose, title = "Heiken Ashi", color = haColor, wickcolor = haColor, bordercolor = color.new(color.black, 40))

sqzColor = noSqz ? color.blue : sqzOn ? color.black : color.gray
plotshape(showSqzDots ? 0.0 : na, title = "Etat squeeze", style = shape.circle, location = location.belowbar, color = sqzColor, size = size.tiny)

// Point vert sous la bougie = retournement haussier ; point rouge au-dessus = retournement baissier
plotshape(sigBull, title = "Retournement haussier", style = shape.circle, location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(sigBear, title = "Retournement baissier", style = shape.circle, location = location.abovebar, color = color.new(color.red, 0),   size = size.small)

// Croix blanche discrete = perte de momentum apres le dernier signal
plotshape(showExitCross and exitAfterBull, title = "Perte de momentum (apres achat)", style = shape.xcross, location = location.abovebar, color = color.new(color.white, 0), size = size.tiny)
plotshape(showExitCross and exitAfterBear, title = "Perte de momentum (apres vente)", style = shape.xcross, location = location.belowbar, color = color.new(color.white, 0), size = size.tiny)

// =========================================================================
// TABLEAU DE BORD (backtest en R)
// =========================================================================
f_dashPos(string s) => s == "Haut gauche" ? position.top_left : s == "Bas droite" ? position.bottom_right : s == "Bas gauche" ? position.bottom_left : position.top_right
f_dashSize(string s) => s == "Minuscule" ? size.tiny : s == "Normal" ? size.normal : size.small

var table dash = table.new(f_dashPos(dashPosIn), 2, 8, border_width = 1, border_color = color.new(color.gray, 70), bgcolor = color.new(color.black, 75))

f_dcell(int c, int r, string t, color tc, bool hdr) =>
    table.cell(dash, c, r, t, text_color = tc, text_size = f_dashSize(dashSizeIn), bgcolor = hdr ? color.new(color.navy, 30) : color.new(color.black, 80))

if barstate.islast and showDash
    color cOk = color.new(color.lime, 0)
    color cKo = color.new(color.red, 0)
    color cWh = color.new(color.white, 0)
    f_dcell(0, 0, "HA SIG - BACKTEST (R)", cWh, true)
    f_dcell(1, 0, syminfo.ticker, cWh, true)
    f_dcell(0, 1, "Trades (G / P / BE)", cWh, false)
    f_dcell(1, 1, str.tostring(btN) + "  (" + str.tostring(btWin) + " / " + str.tostring(btLoss) + " / " + str.tostring(btBE) + ")", cWh, false)
    f_dcell(0, 2, "Taux de reussite", cWh, false)
    f_dcell(1, 2, btN > 0 ? str.tostring(100.0 * btWin / btN, "#.#") + " %" : "-", cWh, false)
    f_dcell(0, 3, "Profit factor", cWh, false)
    f_dcell(1, 3, btGrossL > 0 ? str.tostring(btGrossW / btGrossL, "#.##") : btGrossW > 0 ? "inf" : "-", cWh, false)
    f_dcell(0, 4, "Esperance / trade", cWh, false)
    f_dcell(1, 4, btN > 0 ? (btSum / btN >= 0 ? "+" : "") + str.tostring(btSum / btN, "#.##") + " R" : "-", btN > 0 and btSum >= 0 ? cOk : btN > 0 ? cKo : cWh, false)
    f_dcell(0, 5, "PNL total", cWh, false)
    f_dcell(1, 5, (btSum >= 0 ? "+" : "") + str.tostring(btSum, "#.##") + " R", btSum >= 0 ? cOk : cKo, false)
    f_dcell(0, 6, "Drawdown actuel", cWh, false)
    f_dcell(1, 6, btDdCur > 0 ? "-" + str.tostring(btDdCur, "#.##") + " R" : "0 R", btDdCur > 0 ? cKo : cWh, false)
    f_dcell(0, 7, "Drawdown max", cWh, false)
    f_dcell(1, 7, btDdMax > 0 ? "-" + str.tostring(btDdMax, "#.##") + " R" : "0 R", btDdMax > 0 ? cKo : cWh, false)

// =========================================================================
// ALERTES
// =========================================================================
alertcondition(sigBull, title = "Retournement haussier", message = "HA Sig : cassure du haut de la bougie rouge vive de reference (point vert) sur {{ticker}} {{interval}}")
alertcondition(sigBear, title = "Retournement baissier", message = "HA Sig : cassure du bas de la bougie violette vive de reference (point rouge) sur {{ticker}} {{interval}}")
alertcondition(exitAfterBull, title = "Perte de momentum apres achat", message = "HA Sig : perte de momentum apres le signal d'achat (croix noire) sur {{ticker}} {{interval}}")
alertcondition(exitAfterBear, title = "Perte de momentum apres vente", message = "HA Sig : perte de momentum apres le signal de vente (croix noire) sur {{ticker}} {{interval}}")
