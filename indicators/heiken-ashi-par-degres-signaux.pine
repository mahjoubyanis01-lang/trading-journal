//@version=6
indicator("Heiken Ashi par degres + Signaux", shorttitle="HA Sig", overlay=true, max_lines_count=500)

// =========================================================================
// INPUTS
// =========================================================================
grpSqz = "Squeeze Momentum (LazyBear)"
bbLength     = input.int(20, "BB Length", group = grpSqz)
bbMult       = input.float(2.0, "BB MultFactor", group = grpSqz)
kcLength     = input.int(20, "KC Length", group = grpSqz)
kcMult       = input.float(1.5, "KC MultFactor", group = grpSqz)
useTrueRange = input.bool(true, "Use TrueRange (KC)", group = grpSqz)

grpColor = "Coloration / Graduation"
normLen   = input.int(100, "Fenetre de normalisation du momentum", group = grpColor, tooltip = "Nombre de barres utilisees pour calibrer l'echelle de couleur sur l'amplitude recente du momentum")
dampAlpha = input.int(55, "Transparence en phase de ralentissement", group = grpColor, minval = 0, maxval = 100, tooltip = "0 = pas d'effet, 100 = quasi invisible quand le momentum ralentit")

grpSqzShow  = "Affichage squeeze"
showSqzDots = input.bool(true, "Afficher les points de squeeze sous les bougies", group = grpSqzShow)

grpSig = "Signaux : cassure de la bougie extreme"
showSignals  = input.bool(true, "Afficher les signaux (point vert / point rouge)", group = grpSig)
vividZone    = input.int(75, "Seuil de couleur vive (0-100)", group = grpSig, minval = 40, maxval = 100, tooltip = "Momentum normalise a partir duquel une bougie est consideree violet vif (+) ou rouge vif (-). C'est l'entree en cycle : la premiere bougie vive ouvre la surveillance.")
breakOnClose = input.bool(true, "Cassure a la cloture (sinon a la meche)", group = grpSig, tooltip = "Active : il faut une cloture au-dela du niveau de la bougie de reference. Desactive : une simple meche qui depasse suffit.")
showLevels   = input.bool(true, "Afficher le niveau surveille", group = grpSig, tooltip = "Ligne pointillee sur le niveau attendu : le plus bas de la bougie violette de reference, ou le plus haut de la bougie rouge de reference.")
showExitCross = input.bool(true, "Croix noire de perte de momentum", group = grpSig, tooltip = "Apres chaque signal, marque d'une croix noire la bougie ou la perte de momentum est confirmee : le prix peut potentiellement se retourner dans le sens inverse. Au-dessus de la bougie apres un achat, en dessous apres une vente. Une seule croix par signal.")
crossBars     = input.int(2, "Bougies de repli pour confirmer la croix", group = grpSig, minval = 1, maxval = 10, tooltip = "Nombre de bougies CONSECUTIVES de momentum a contre-sens du signal necessaires pour poser la croix. 1 = des le premier flechissement (bruyant). 2-3 = la perte d'elan est confirmee et le risque de retournement du prix est reel.")
maxWait      = input.int(0, "Validite du niveau (barres, 0 = illimitee)", group = grpSig, minval = 0, maxval = 500, tooltip = "Nombre de barres au-dela duquel un niveau non casse est abandonne.")
cancelBars   = input.int(3, "Bougies non vives consecutives = cycle perdu", group = grpSig, minval = 1, maxval = 20, tooltip = "Si ce nombre de bougies consecutives perdent la couleur vive pendant un cycle, le cycle est annule : le niveau est abandonne et aucun signal ne peut plus en sortir. La cassure doit donc survenir pendant que la couleur vive est encore presente ou juste apres son extinction.")

grpMs = "Market structure (P1)"
useP1 = input.bool(true, "Reference = bougie P1 (extension) obligatoire", group = grpMs, tooltip = "La bougie de reference du cycle doit etre une bougie de phase 1 de la structure de marche : une bougie d'extension qui fait un nouveau plus haut structurel (cycle violet) ou un nouveau plus bas structurel (cycle rouge). Une bougie vive qui n'etend pas la structure ne peut pas servir de reference.")
msRh  = input.int(0, "Reset structure : heure (Paris)", minval = 0, maxval = 23, group = grpMs)
msRm  = input.int(0, "Reset structure : minute", minval = 0, maxval = 59, group = grpMs)

// =========================================================================
// HEIKEN ASHI (OHLC)
// =========================================================================
haTicker = ticker.heikinashi(syminfo.tickerid)
haOpen   = request.security(haTicker, timeframe.period, open)
haHigh   = request.security(haTicker, timeframe.period, high)
haLow    = request.security(haTicker, timeframe.period, low)
haClose  = request.security(haTicker, timeframe.period, close)

// =========================================================================
// SQUEEZE MOMENTUM (LazyBear) -- recalcul en v6, sur le prix reel
// =========================================================================
source = close
basis  = ta.sma(source, bbLength)
dev    = bbMult * ta.stdev(source, bbLength)
upperBB = basis + dev
lowerBB = basis - dev

ma      = ta.sma(source, kcLength)
rangeV  = useTrueRange ? ta.tr(true) : (high - low)
rangema = ta.sma(rangeV, kcLength)
upperKC = ma + rangema * kcMult
lowerKC = ma - rangema * kcMult

sqzOn  = (lowerBB > lowerKC) and (upperBB < upperKC)
sqzOff = (lowerBB < lowerKC) and (upperBB > upperKC)
noSqz  = not sqzOn and not sqzOff

val = ta.linreg(source - math.avg(math.avg(ta.highest(high, kcLength), ta.lowest(low, kcLength)), ta.sma(close, kcLength)), kcLength, 0)

// =========================================================================
// GRADUATION DE COULEUR (remplace le vert/rouge classique de HA)
// =========================================================================
// Normalisation du momentum sur son amplitude recente -> echelle -100 / +100
normVal = 100 * nz(val) / math.max(ta.highest(math.abs(val), normLen), 1e-10)
normVal := math.max(math.min(normVal, 100), -100)

// Le momentum se renforce dans son sens (equivalent du lime/red de l'original)
// ou faiblit en revenant vers zero (equivalent du green/maroon, plus terne)
strengthening = val > 0 ? (val > nz(val[1])) : (val < nz(val[1]))

baseColor = normVal >= 0 ?
     color.from_gradient(normVal, 0, 100, color.new(color.gray, 45), color.new(#cd00db, 0)) :
     color.from_gradient(normVal, -100, 0, color.new(color.red, 0), color.new(color.gray, 45))

haColor = strengthening ? baseColor : color.new(baseColor, dampAlpha)

// =========================================================================
// MARKET STRUCTURE -- moteur P1-P4 reduit (detection P1 uniquement)
// =========================================================================
// Porte du script Market Structure : seule la detection des bougies de
// PHASE 1 (extension : nouveau plus haut / plus bas structurel pendant
// l'impulsion) est utilisee ici. Calcule sur les bougies reelles.
tzMs = "Europe/Paris"
bool msNd = hour(time, tzMs) == msRh and minute(time, tzMs) == msRm and (hour(nz(time[1], time - 1), tzMs) != msRh or minute(nz(time[1], time - 1), tzMs) != msRm)

var int   msTr  = 1
var int   msSt  = 0
var float msP1e = na
var float msP1o = na
var float msP2e = na
var float msPp2 = na
var float msPp1 = na
var bool  msHp1 = false

if na(msP1e)
    msTr  := close >= open ? 1 : -1
    msP1e := close >= open ? high : low
    msP1o := close >= open ? low  : high
    msPp2 := close >= open ? high : low

if msNd
    msTr  := close >= open ? 1 : -1
    msSt  := 0
    msP1e := close >= open ? high : low
    msP1o := close >= open ? low  : high
    msP2e := na
    msPp2 := close >= open ? high : low
    msPp1 := na
    msHp1 := false

bool isP1up = false   // cette bougie est une extension haussiere (P1+)
bool isP1dn = false   // cette bougie est une extension baissiere (P1-)

if msTr == 1
    if msSt == 0 and high > msP1e
        msP1e := high
        msP1o := low
        msHp1 := true
        isP1up := true
    if msSt == 0 and high <= msP1e and low < msP1o
        msP2e := low
        msSt  := 1
    if msSt == 1 and low < msP2e
        msP2e := low
    if msSt == 1 and close > msP1e
        msPp2 := msP2e
        msPp1 := na
        msHp1 := false
        msP1e := high
        msP1o := low
        msP2e := na
        msSt  := 0
    bool msTdn = (not na(msPp2) and close < msPp2) or (msHp1 and not na(msPp1) and close < msPp1)
    if msSt == 1 and msTdn and not (close > msP1e)
        msPp2 := na
        msPp1 := msP1e
        msHp1 := true
        msTr  := -1
        msSt  := 0
        msP1e := low
        msP1o := high
        msP2e := na

if msTr == -1
    if msSt == 0 and low < msP1e
        msP1e := low
        msP1o := high
        msHp1 := true
        isP1dn := true
    if msSt == 0 and low >= msP1e and high > msP1o
        msP2e := high
        msSt  := 1
    if msSt == 1 and high > msP2e
        msP2e := high
    if msSt == 1 and close < msP1e
        msPp2 := msP2e
        msPp1 := na
        msHp1 := false
        msP1e := low
        msP1o := high
        msP2e := na
        msSt  := 0
    bool msTup = (not na(msPp2) and close > msPp2) or (msHp1 and not na(msPp1) and close > msPp1)
    if msSt == 1 and msTup and not (close < msP1e)
        msPp2 := na
        msPp1 := msP1e
        msHp1 := true
        msTr  := 1
        msSt  := 0
        msP1e := high
        msP1o := low
        msP2e := na

// =========================================================================
// SIGNAUX : CASSURE DE LA BOUGIE EXTREME
// =========================================================================
// Quand la couleur devient VIVE (violet vif = normVal >= seuil, rouge vif
// = normVal <= -seuil), un cycle s'ouvre sur la premiere bougie vive.
//  - Cycle VIOLET : parmi les bougies violet vif depuis la premiere du
//    cycle, on retient celle qui a fait LE PLUS HAUT ; sa reference est
//    son plus haut et son plus bas (meche et corps compris).
//    SIGNAL BAISSIER = cassure de SON PLUS BAS.
//  - Cycle ROUGE : la bougie rouge vif ayant fait LE PLUS BAS depuis la
//    premiere rouge vive du cycle.
//    SIGNAL HAUSSIER = cassure de SON PLUS HAUT.
// Un signal clot le cycle ; un passage a la couleur vive opposee bascule
// le cycle (l'ancien niveau est abandonne).

// Une bougie est VIVE seulement si sa couleur est PLEINE, pas terne :
// zone extreme atteinte ET momentum qui se renforce (strengthening).
// Une bougie violette ou rouge mais assombrie/transparente (momentum qui
// decelere, effet dampAlpha) n'est PAS vive : elle ne peut ni ouvrir un
// cycle, ni devenir la bougie de reference, ni remettre a zero le
// compteur de cycle perdu.
bool vividUp = normVal >=  vividZone and strengthening    // violet vif (couleur pleine)
bool vividDn = normVal <= -vividZone and strengthening    // rouge vif (couleur pleine)

var int   epDir  = 0    // 1 = cycle violet (attend cassure du bas), -1 = cycle rouge (attend cassure du haut)
var float refHi  = na   // extremes de la bougie de reference
var float refLo  = na
var int   refBar = na
var line  refLn  = na

// Ouverture / bascule de cycle sur la premiere bougie vive.
// La reference n'est pas forcement posee a l'ouverture : seule une bougie
// vive qui est AUSSI une bougie P1 (extension structurelle) peut servir
// de reference quand le filtre est actif.
if vividUp and epDir != 1
    epDir  := 1
    refHi  := na
    refLo  := na
    refBar := na
    if not na(refLn)
        line.delete(refLn)
    refLn := na
if vividDn and epDir != -1
    epDir  := -1
    refHi  := na
    refLo  := na
    refBar := na
    if not na(refLn)
        line.delete(refLn)
    refLn := na

// Pose / mise a jour de la bougie de reference : bougie VIVE, bougie P1
// (si le filtre est actif), et nouvel extreme du cycle.
if epDir == 1 and vividUp and (not useP1 or isP1up) and (na(refHi) or haHigh > refHi)
    refHi  := haHigh
    refLo  := haLow
    refBar := bar_index
    if na(refLn)
        refLn := showLevels ? line.new(bar_index, refLo, bar_index + 1, refLo, color = color.new(#cd00db, 0), style = line.style_dashed, width = 2) : na
    else
        line.set_xy1(refLn, bar_index, refLo)
        line.set_xy2(refLn, bar_index + 1, refLo)
if epDir == -1 and vividDn and (not useP1 or isP1dn) and (na(refLo) or haLow < refLo)
    refHi  := haHigh
    refLo  := haLow
    refBar := bar_index
    if na(refLn)
        refLn := showLevels ? line.new(bar_index, refHi, bar_index + 1, refHi, color = color.new(color.red, 0), style = line.style_dashed, width = 2) : na
    else
        line.set_xy1(refLn, bar_index, refHi)
        line.set_xy2(refLn, bar_index + 1, refHi)

// Extension du niveau surveille jusqu'a la bougie courante
if epDir != 0 and not na(refLn)
    line.set_x2(refLn, bar_index)

// Expiration optionnelle d'un niveau jamais casse
if epDir != 0 and not na(refBar) and maxWait > 0 and bar_index - refBar > maxWait
    epDir := 0
    refLn := na   // la ligne reste a l'ecran, figee

// CYCLE PERDU : N bougies consecutives sans couleur vive -> le cycle est
// annule, son niveau est retire, aucun signal ne peut plus en sortir.
var int fadeCnt = 0
fadeCnt := epDir == 1 ? (vividUp ? 0 : fadeCnt + 1) : epDir == -1 ? (vividDn ? 0 : fadeCnt + 1) : 0
if epDir != 0 and fadeCnt >= cancelBars
    epDir := 0
    if not na(refLn)
        line.delete(refLn)
    refLn := na

// Cassure de la reference -> signal (et cloture du cycle)
bool brkDn = epDir == 1  and not na(refLo) and bar_index > refBar and (breakOnClose ? haClose < refLo : haLow  < refLo)
bool brkUp = epDir == -1 and not na(refHi) and bar_index > refBar and (breakOnClose ? haClose > refHi : haHigh > refHi)

bearSignal = showSignals and brkDn
bullSignal = showSignals and brkUp

if brkDn or brkUp
    epDir := 0
    refLn := na   // la ligne reste figee a l'endroit de la cassure

// =========================================================================
// CROIX DE PERTE DE MOMENTUM (une par signal)
// =========================================================================
// But : signaler quand le prix peut POTENTIELLEMENT se retourner dans le
// sens inverse du signal. Pour eviter le bruit d'un simple flechissement
// d'une bougie, la croix exige 'crossBars' bougies CONSECUTIVES de
// momentum a contre-sens :
//  - apres un ACHAT : 'crossBars' bougies de momentum en baisse
//    -> croix noire AU-DESSUS de la bougie de confirmation ;
//  - apres une VENTE : 'crossBars' bougies de momentum en hausse
//    -> croix noire EN DESSOUS de la bougie de confirmation.
var int momDnCnt = 0
var int momUpCnt = 0
momDnCnt := nz(val) < nz(val[1]) ? momDnCnt + 1 : 0
momUpCnt := nz(val) > nz(val[1]) ? momUpCnt + 1 : 0

var int pendingExit = 0    // 1 = achat en attente de croix, -1 = vente, 0 = rien
var int sigBarIdx   = na
bool exitAfterBull = false
bool exitAfterBear = false
if pendingExit == 1 and not na(sigBarIdx) and bar_index > sigBarIdx and momDnCnt >= crossBars
    exitAfterBull := true
    pendingExit := 0
if pendingExit == -1 and not na(sigBarIdx) and bar_index > sigBarIdx and momUpCnt >= crossBars
    exitAfterBear := true
    pendingExit := 0
if bullSignal
    pendingExit := 1
    sigBarIdx := bar_index
if bearSignal
    pendingExit := -1
    sigBarIdx := bar_index

// =========================================================================
// AFFICHAGE
// =========================================================================
plotcandle(haOpen, haHigh, haLow, haClose, title = "Heiken Ashi", color = haColor, wickcolor = haColor, bordercolor = color.new(color.black, 40))

sqzColor = noSqz ? color.blue : sqzOn ? color.black : color.gray
plotshape(showSqzDots ? 0.0 : na, title = "Etat squeeze", style = shape.circle, location = location.belowbar, color = sqzColor, size = size.tiny)

// Point vert sous la bougie = retournement haussier ; point rouge au-dessus = retournement baissier
plotshape(bullSignal, title = "Retournement haussier", style = shape.circle, location = location.belowbar, color = color.new(color.green, 0), size = size.small)
plotshape(bearSignal, title = "Retournement baissier", style = shape.circle, location = location.abovebar, color = color.new(color.red, 0),   size = size.small)

// Croix noire = perte de momentum apres le dernier signal
plotshape(showExitCross and exitAfterBull, title = "Perte de momentum (apres achat)", style = shape.xcross, location = location.abovebar, color = color.new(color.black, 0), size = size.small)
plotshape(showExitCross and exitAfterBear, title = "Perte de momentum (apres vente)", style = shape.xcross, location = location.belowbar, color = color.new(color.black, 0), size = size.small)

// =========================================================================
// ALERTES
// =========================================================================
alertcondition(bullSignal, title = "Retournement haussier", message = "HA Sig : cassure du haut de la bougie rouge vive de reference (point vert) sur {{ticker}} {{interval}}")
alertcondition(bearSignal, title = "Retournement baissier", message = "HA Sig : cassure du bas de la bougie violette vive de reference (point rouge) sur {{ticker}} {{interval}}")
alertcondition(exitAfterBull, title = "Perte de momentum apres achat", message = "HA Sig : perte de momentum apres le signal d'achat (croix noire) sur {{ticker}} {{interval}}")
alertcondition(exitAfterBear, title = "Perte de momentum apres vente", message = "HA Sig : perte de momentum apres le signal de vente (croix noire) sur {{ticker}} {{interval}}")
