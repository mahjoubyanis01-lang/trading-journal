# Python
__pycache__/
*.pyc
.venv/
backend/.venv/
.pytest_cache/

# Local data (SQLite DB + runtime files) - never commit
data/
*.db

# Node / frontend
node_modules/
frontend/node_modules/
*.tsbuildinfo
# NOTE: frontend/dist IS committed on purpose, so the app runs with only Python
# (no Node needed at launch). Rebuild with `npm run build` after UI changes.

# Env / secrets (credentials never belong in Git anyway, see §7)
.env
*.log
