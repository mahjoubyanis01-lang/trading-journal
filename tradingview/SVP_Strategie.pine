//@version=6
// =============================================================================
//  SVP — STRATEGIE sur les signaux VAH / VAL
//  (meme logique que l'indicateur SVP_Signaux.pine, + gestion des positions)
//
//  SVP — Session Volume Profile (VAH / VAL figes en fin de journee)
//  - Profil calcule sur les bougies 30 min (reglable) : bien plus d'historique
//    qu'en 1 min, donc beaucoup plus de seances et de niveaux visibles, meme sur
//    un graphique 1 min. Les touches restent detectees a la minute pres (avant
//    le debut de l'historique du graphique : sur les bougies 30 min).
//  - Les niveaux ne sont traces QU'A LA CLOTURE de chaque seance.
//  - Chaque niveau s'etend vers la droite (facon TradingView).
//  - J-1 (derniere seance close) : l'extension court jusqu'a la bougie
//    courante et ne se coupe PAS, meme touchee, jusqu'a la fin du jour.
//  - J-2 et plus ancien : l'extension se coupe a la 1re bougie dont la
//    meche touche le niveau (low <= niveau <= high) ; sinon elle continue.
//  - A la bascule (J finit, J+1 demarre) l'ancienne J-1 devient J-2 et son
//    extension est retro-coupee a la 1re touche survenue pendant le jour ecoule.
//  - Une touche ne compte QUE dans la plage horaire choisie (15h30 -> 22h15
//    heure de Paris par defaut) ; hors plage, les niveaux continuent de s'etendre.
//    La plage est verifiee sur les intrabars 1 min : exacte quelle que soit
//    l'unite de temps du graphique.
//
//  SIGNAUX (touche dans la plage horaire)
//  - Chaque bougie qui touche un niveau valide (VAH / VAL, meche ou corps)
//    devient la bougie de reference ; la plus recente remplace la precedente.
//    Peu importe d'ou vient le prix : achat comme vente sont possibles.
//  - Reference haussiere -> VENTE a la cassure de son plus bas ;
//    reference baissiere -> ACHAT a la cassure de son plus haut.
//    La bougie entiere, meches comprises (cassure en cloture par defaut).
//    Une bougie sans corps (ouverture = cloture) ne devient pas reference.
//  - Tant que la seance du jour n'est pas finie, un niveau peut etre touche
//    plusieurs fois (meme un niveau J-2 deja coupe aujourd'hui).
//  - Exception a la plage : la bougie pre-open (la derniere avant la plage,
//    15h29 en 1 min) compte aussi si elle touche un niveau (meche ou corps).
//  - Sans cassure, le setup expire apres N bougies ou a la fin de la plage.
//
//  STRATEGIE
//  - Entree a la cloture de la bougie signal.
//  - SL = plus bas (achat) / plus haut (vente) de la bougie de reference.
//  - TP = prochain niveau VAH ou VAL encore intact au-dessus de l'entree (achat)
//    / en dessous (vente). Un niveau deja touche pendant la seance (dont celui
//    qui a active le setup) ne peut pas etre un TP. Pas de niveau intact dans
//    le sens du trade -> pas de position.
//  - Taille : risque fixe en $ par position. Quantite = risque / (distance au SL
//    x valeur du point en $), arrondie au pas inferieur (contrats entiers par
//    defaut) pour ne jamais depasser le risque. Si un seul contrat depasse deja
//    le risque, pas de position (sauf option). Mode quantite fixe disponible.
//  - Gestion du SL selon le chemin parcouru vers le TP :
//    TP a plus de 3R : a 25 % du TP -> SL au prix d'entree (break-even),
//                      a 75 % du TP -> SL a +25 % du TP ;
//    sinon           : a 50 % du TP -> SL au prix d'entree (break-even).
//  - Une seule position a la fois, 1 position maximum par seance (reglable).
//    Si plusieurs sont autorisees : apres un TP, plus de position ce jour-la ;
//    apres un SL, un break-even ou le SL a +25 %, une autre reste possible.
//  - Sens autorise selon le range du jour : nouveau plus bas du jour pendant la
//    plage horaire (apres 15h30) -> achats seulement ; nouveau plus haut du jour
//    -> ventes seulement ; tant que le prix reste dans le range du jour ->
//    achats et ventes. Le dernier extreme casse decide.
//  - A chaque sortie (TP, SL, break-even, SL a +25 %) : etiquette avec le R
//    obtenu (gain par contrat / risque initial), ex. "TP · +3.2R", et une alerte
//    (creer une alerte sur la strategie avec "appels de la fonction alert()").
//  - Tableau de backtest en R (en haut a droite) : trades, win rate, profit
//    factor, esperance par trade, PnL total et drawdown max, en R.
//  - Marge a 0 % : la taille est fixee par le risque en $, pas par le capital
//    (avec une marge de 100 %, TradingView refuse les ordres dont la valeur
//    totale depasse le capital, ce qui arrive vite sur les futures).
//  - Un losange de couleur marque chaque position reellement ouverte (verifie
//    dans la liste des trades) ; les signaux non pris ne sont pas affiches.
// =============================================================================
strategy("SVP — Strategie VAH/VAL", "SVP Strat", overlay=true, max_lines_count=500, max_labels_count=500,
     process_orders_on_close=true, default_qty_type=strategy.fixed, default_qty_value=1, currency=currency.USD,
     margin_long=0, margin_short=0)

//========================== INPUTS ==========================
svpTf      = input.timeframe("30", "Unite de temps du calcul SVP", group="Profil")
calc_ticks = input.int(1,    "Precision du calcul (ticks par niveau)", minval=1, maxval=50, group="Profil")
percent    = input.float(70.,"Value Area Volume %", minval=0, maxval=100, group="Profil")
keepSess   = input.int(60,   "Seances conservees a l'ecran", minval=1, maxval=240, group="Affichage")
touchOnly  = input.bool(true, "Touche comptee uniquement de", inline="tw", group="Touche")
touchSess  = input.session("1530-2215", "", inline="tw", group="Touche")
touchTz    = input.string("Europe/Paris", "Fuseau horaire de la plage", options=["Europe/Paris", "America/New_York", "America/Chicago", "UTC"], group="Touche")

sigOn      = input.bool(true, "Afficher les signaux", group="Signaux")
brkClose   = input.bool(true, "Cassure validee en cloture (sinon meche)", group="Signaux")
setupBars  = input.int(10, "Validite du setup (bougies apres la reference)", minval=1, maxval=100, group="Signaux")

//========================== DONNEES INTRABAR (1 minute) ==========================
// Servent a verifier la plage horaire des touches a la minute pres.
ltf = timeframe.in_seconds() < 60 ? timeframe.period : "1"
[iT, iH, iL] = request.security_lower_tf(syminfo.tickerid, ltf, [time, high, low])

//========================== FENETRE DE TOUCHE ==========================
// Plage "HHMM-HHMM" -> minutes depuis minuit (une plage qui passe minuit est geree).
f_hhmm(s) =>
    int v = int(str.tonumber(s))
    int(v / 100) * 60 + v % 100
int touchBeg = f_hhmm(str.substring(touchSess, 0, 4))
int touchEnd = f_hhmm(str.substring(touchSess, 5, 9))

f_inWin(t) =>
    int m = hour(t, touchTz) * 60 + minute(t, touchTz)
    touchBeg <= touchEnd ? (m >= touchBeg and m < touchEnd) : (m >= touchBeg or m < touchEnd)

//========================== VA D'UNE SEANCE (au tick) ==========================
// Volume de chaque bougie reparti uniformement sur son range, puis Value Area autour du POC.
f_va(aH, aL, aV, sesLo, sesHi) =>
    float _vah = na
    float _val = na
    int n = array.size(aV)
    if n > 0 and not na(sesLo) and not na(sesHi) and sesHi > sesLo
        float rng   = sesHi - sesLo
        int   kmult = math.max(calc_ticks, int(math.ceil(rng / (syminfo.mintick * 2000))))
        float fstep = syminfo.mintick * kmult
        int   fnum  = int(math.ceil(rng / fstep)) + 1
        if fnum > 20000
            fnum  := 20000
            fstep := rng / 20000
        array<float> gDiff = array.new_float(fnum + 2, 0.)
        array<float> gTot  = array.new_float(fnum, 0.)
        for k = 0 to n - 1
            float bh = array.get(aH, k)
            float bl = array.get(aL, k)
            float vv = array.get(aV, k)
            if vv > 0
                int j0 = math.min(fnum - 1, math.max(0, int(math.floor((bl - sesLo) / fstep))))
                int j1 = math.min(fnum - 1, math.max(0, int(math.floor((bh - sesLo) / fstep))))
                if bh - bl <= 0 or j1 == j0
                    array.set(gDiff, j0,     array.get(gDiff, j0)     + vv)
                    array.set(gDiff, j0 + 1, array.get(gDiff, j0 + 1) - vv)
                else
                    float dens = vv / (bh - bl)
                    float e0   = dens * math.max(sesLo + (j0 + 1) * fstep - bl, 0)
                    float e1   = dens * math.max(bh - (sesLo + j1 * fstep), 0)
                    array.set(gDiff, j0,     array.get(gDiff, j0)     + e0)
                    array.set(gDiff, j0 + 1, array.get(gDiff, j0 + 1) - e0)
                    array.set(gDiff, j1,     array.get(gDiff, j1)     + e1)
                    array.set(gDiff, j1 + 1, array.get(gDiff, j1 + 1) - e1)
                    if j1 - j0 >= 2
                        float dfull = dens * fstep
                        array.set(gDiff, j0 + 1, array.get(gDiff, j0 + 1) + dfull)
                        array.set(gDiff, j1,     array.get(gDiff, j1)     - dfull)
        float run = 0.
        float tot = 0.
        int   poc = 0
        float mxv = -1.
        for j = 0 to fnum - 1
            run += array.get(gDiff, j)
            array.set(gTot, j, run)
            tot += run
            if run > mxv
                mxv := run
                poc := j
        float target = tot * percent / 100.
        float acc = array.get(gTot, poc)
        int u = poc
        int d = poc
        while acc < target and (u < fnum - 1 or d > 0)
            float uv = u < fnum - 1 ? array.get(gTot, u + 1) : 0.
            float lv = d > 0        ? array.get(gTot, d - 1) : 0.
            if d <= 0 or (u < fnum - 1 and uv >= lv)
                acc += uv
                u += 1
            else
                acc += lv
                d -= 1
        if tot > 0
            _vah := math.round_to_mintick(sesLo + fstep * u)
            _val := math.round_to_mintick(sesLo + fstep * d)
    [_vah, _val]

//========================== NIVEAUX DES SEANCES CLOSES (unite svpTf) ==========================
// Calcule dans l'unite de temps du calcul SVP (30 min par defaut) : bien plus d'historique
// qu'en 1 min, donc beaucoup plus de seances et de niveaux, meme sur un graphique 1 min.
// Pour chaque seance close : debut, VAH, VAL et heure de la 1re touche de chaque niveau
// dans la plage horaire apres la cloture de la seance (na = pas encore touche).
f_htfLevels() =>
    var array<int>   aT    = array.new_int()
    var array<float> aVah  = array.new_float()
    var array<float> aVal  = array.new_float()
    var array<int>   aCutH = array.new_int()
    var array<int>   aCutL = array.new_int()
    var array<float> bH    = array.new_float()
    var array<float> bL    = array.new_float()
    var array<float> bV    = array.new_float()
    var int   sT  = na
    var float sLo = na
    var float sHi = na
    int dch = nz(ta.change(time("D")), 0)
    if na(time[1]) or dch != 0
        [vh, vl] = f_va(bH, bL, bV, sLo, sHi)
        if not na(vh) and not na(sT)
            array.push(aT, sT)
            array.push(aVah, vh)
            array.push(aVal, vl)
            array.push(aCutH, int(na))
            array.push(aCutL, int(na))
            if array.size(aT) > keepSess
                array.shift(aT)
                array.shift(aVah)
                array.shift(aVal)
                array.shift(aCutH)
                array.shift(aCutL)
        array.clear(bH)
        array.clear(bL)
        array.clear(bV)
        sT  := time
        sLo := na
        sHi := na
    array.push(bH, high)
    array.push(bL, low)
    array.push(bV, nz(volume))
    sLo := na(sLo) ? low  : math.min(sLo, low)
    sHi := na(sHi) ? high : math.max(sHi, high)
    if (not touchOnly or f_inWin(time)) and array.size(aT) > 0
        for i = 0 to array.size(aT) - 1
            float h1 = array.get(aVah, i)
            float l1 = array.get(aVal, i)
            if na(array.get(aCutH, i)) and low <= h1 and high >= h1
                array.set(aCutH, i, time)
            if na(array.get(aCutL, i)) and low <= l1 and high >= l1
                array.set(aCutL, i, time)
    [aT, aVah, aVal, aCutH, aCutL]

[hT, hVah, hVal, hCutH, hCutL] = request.security(syminfo.tickerid, svpTf, f_htfLevels())

//========================== SESSION (jour du graphique) ==========================
var int d_start = na
var int firstT  = time    // 1re bougie du graphique : avant elle, seules les touches svpTf sont connues
dayChg = ta.change(time("D"))
bool new_sess = na(time[1]) or nz(dayChg, 0) != 0
if new_sess
    d_start := time

// Bougie pre-open : la derniere bougie avant la plage (15h29 en 1 min, 15h25 en 5 min).
// Si elle touche un niveau (meche ou corps), elle compte comme une touche : elle peut donc
// etre bougie de reference.
int  sod     = hour(time, touchTz) * 3600 + minute(time, touchTz) * 60 + second(time, touchTz)
bool preOpen = touchOnly and (sod + timeframe.in_seconds()) % 86400 == touchBeg * 60

// tLo / tHi = extremes atteints DANS la plage pendant la bougie courante (bougie entiere
// pour la pre-open ; na si aucune minute de la bougie n'est dans la plage -> pas de touche).
float tLo = na
float tHi = na
if not touchOnly or preOpen
    tLo := low
    tHi := high
else
    int nTb = array.size(iT)
    if nTb > 0
        for k = 0 to nTb - 1
            if f_inWin(array.get(iT, k))
                tLo := na(tLo) ? array.get(iL, k) : math.min(tLo, array.get(iL, k))
                tHi := na(tHi) ? array.get(iH, k) : math.max(tHi, array.get(iH, k))
    else if f_inWin(time)
        tLo := low
        tHi := high
bool canTouch = not na(tLo) and not na(tHi)

//========================== LIGNES DES NIVEAUX ==========================
// Une ligne VAH et une ligne VAL par seance close, de son debut vers la droite.
// - J-1 (derniere seance close) : s'etend jusqu'a la bougie courante et ne se coupe pas
//   aujourd'hui ; quand elle devient J-2, elle est retro-coupee a sa 1re touche.
// - J-2 et plus ancien : coupe a la 1re touche dans la plage, sinon continue.
var array<int>  kT    = array.new_int()     // seances dessinees (debut), meme ordre que hT
var array<line> lnH   = array.new<line>()
var array<line> lnL   = array.new<line>()
var array<int>  cCutH = array.new_int()     // 1re touche vue sur le graphique (heure de la bougie)
var array<int>  cCutL = array.new_int()
var array<bool> fixH  = array.new_bool()    // ligne figee a sa coupure
var array<bool> fixL  = array.new_bool()

color cVah = #2962ff
color cVal = #ff9800
color cBuy  = color.rgb(0, 120, 255)    // losanges d'achat
color cSell = color.rgb(255, 0, 150)    // losanges de vente

// Synchronisation avec les seances closes : nouvelle seance -> nouvelles lignes,
// seance elaguee -> lignes supprimees.
int nS = array.size(hT)
if nS > 0
    int lastK = array.size(kT) > 0 ? array.last(kT) : na
    if na(lastK) or array.last(hT) != lastK
        for i = 0 to nS - 1
            int st = array.get(hT, i)
            if na(lastK) or st > lastK
                array.push(kT, st)
                array.push(lnH, line.new(st, array.get(hVah, i), time, array.get(hVah, i), xloc=xloc.bar_time, color=cVah, width=1))
                array.push(lnL, line.new(st, array.get(hVal, i), time, array.get(hVal, i), xloc=xloc.bar_time, color=cVal, width=1))
                array.push(cCutH, int(na))
                array.push(cCutL, int(na))
                array.push(fixH, false)
                array.push(fixL, false)
        while array.size(kT) > 0 and array.first(kT) < array.first(hT)
            line.delete(array.shift(lnH))
            line.delete(array.shift(lnL))
            array.shift(kT)
            array.shift(cCutH)
            array.shift(cCutL)
            array.shift(fixH)
            array.shift(fixL)

// Un niveau sur la bougie courante : coupure (1re touche dans la plage) et extension de la
// ligne. Coupure connue : touche vue sur le graphique, sinon touche svpTf anterieure au debut
// du graphique. Renvoie true si la bougie touche ce niveau et qu'il est encore valide
// aujourd'hui (non coupe, ou coupe pendant la seance du jour).
f_level(lv, ln, hc, cuts, fixs, j, isJ1) =>
    int  cc  = array.get(cuts, j)
    int  cut = not na(cc) ? cc : (not na(hc) and hc < firstT ? hc : na)
    bool ok  = na(cut) or cut >= d_start      // coupe aujourd'hui : reste touchable jusqu'a la fin de la seance
    bool hit = ok and canTouch and tLo <= lv and tHi >= lv
    if hit and na(cc)
        array.set(cuts, j, time)
        cut := time
    if not array.get(fixs, j)
        if not na(cut) and not (isJ1 and cut >= d_start)
            line.set_x2(ln, cut)
            array.set(fixs, j, true)
        else
            line.set_x2(ln, time)
    hit

bool touchedLv = false     // la bougie touche au moins un niveau valide
if nS > 0 and array.size(kT) == nS
    for j = 0 to nS - 1
        bool isJ1 = j == nS - 1
        bool hitH = f_level(array.get(hVah, j), array.get(lnH, j), array.get(hCutH, j), cCutH, fixH, j, isJ1)
        bool hitL = f_level(array.get(hVal, j), array.get(lnL, j), array.get(hCutL, j), cCutL, fixL, j, isJ1)
        touchedLv := touchedLv or hitH or hitL

//========================== SIGNAUX ==========================
// Bougie de reference : chaque bougie qui touche un niveau valide (meche ou corps), la plus
// recente remplacant la precedente ; achat comme vente sont possibles.
// - Reference haussiere -> VENTE a la cassure de son plus bas.
// - Reference baissiere -> ACHAT a la cassure de son plus haut.
// La bougie entiere (meches comprises) ; une bougie sans corps ne devient pas reference.
var int   refDir = 0       // 1 : reference baissiere (achat attendu), -1 : haussiere (vente attendue)
var float refH   = na
var float refL   = na
var int   refBar = na
bool  buySig  = false
bool  sellSig = false
float sigSL   = na         // SL du signal : extreme oppose de la bougie de reference
if refDir != 0 and (not canTouch or bar_index - refBar > setupBars)
    refDir := 0
if refDir == 1 and (brkClose ? close : high) > refH
    buySig := true
    sigSL  := refL
    refDir := 0
else if refDir == -1 and (brkClose ? close : low) < refL
    sellSig := true
    sigSL   := refH
    refDir  := 0
if touchedLv and close != open
    refDir := close < open ? 1 : -1
    refH   := high
    refL   := low
    refBar := bar_index

//========================== STRATEGIE ==========================
// Taille de position : risque fixe en $ (quantite = risque / risque d'un contrat), ou quantite fixe.
riskMode = input.string("Risque fixe en $", "Taille de position", options=["Risque fixe en $", "Quantite fixe"], group="Risque")
riskUsd  = input.float(200, "Risque par position ($)", minval=1, group="Risque")
fixQty   = input.float(1, "Quantite fixe (contrats / lots)", minval=0.0001, group="Risque")
qtyStep  = input.float(1, "Pas de quantite (1 = contrats entiers)", minval=0.0001, group="Risque")
minQty   = input.bool(false, "Si 1 contrat depasse le risque, le prendre quand meme", group="Risque")
showR    = input.bool(true, "Afficher le R obtenu a chaque sortie", group="Risque")
maxTrades = input.int(1, "Positions max par seance", minval=1, maxval=5, group="Risque")
showStats = input.bool(true, "Afficher le tableau de backtest (R)", group="Risque")

// Valeur en $ d'un point de prix pour 1 contrat (2 $ sur MNQ, 20 $ sur NQ, 5 $ sur MES...)
float fxUsd    = request.currency_rate(syminfo.currency, currency.USD, ignore_invalid_currency=true)
float pointUsd = syminfo.pointvalue * fxUsd

// Quantite pour une distance au SL, arrondie au pas inferieur : le risque n'est jamais depasse.
f_qty(dist) =>
    float q = math.floor(riskUsd / (dist * pointUsd) / qtyStep + 1e-9) * qtyStep
    riskMode == "Quantite fixe" ? fixQty : q < qtyStep and minQty ? qtyStep : q

// TP possibles : niveaux encore intacts, jamais touches (coupure inconnue sur le graphique
// comme en svpTf). Un niveau touche pendant la seance - dont celui qui a active le setup -
// ne peut donc pas servir de TP.
f_intact(cc, hc) =>
    na(cc) and (na(hc) or hc >= firstT)

array<float> tpLv = array.new_float()
if nS > 0 and array.size(kT) == nS
    for j = 0 to nS - 1
        if f_intact(array.get(cCutH, j), array.get(hCutH, j))
            array.push(tpLv, array.get(hVah, j))
        if f_intact(array.get(cCutL, j), array.get(hCutL, j))
            array.push(tpLv, array.get(hVal, j))

// Prochain niveau intact au-dessus (dir = 1) ou en dessous (dir = -1) d'un prix
f_nextLevel(px, dir) =>
    float best = na
    if array.size(tpLv) > 0
        for i = 0 to array.size(tpLv) - 1
            float lv = array.get(tpLv, i)
            if (dir > 0 ? lv > px : lv < px) and (na(best) or math.abs(lv - px) < math.abs(best - px))
                best := lv
    best

// Sens autorise selon le range du jour (depuis le debut de la seance) : un nouveau plus bas
// du jour pendant la plage horaire -> achats seulement ; un nouveau plus haut -> ventes
// seulement ; dans le range -> les deux. Le dernier extreme casse decide.
var float dayHi   = na
var float dayLo   = na
var int   dayBias = 0      // 1 : achats seulement, -1 : ventes seulement, 0 : les deux
if new_sess
    dayHi   := na
    dayLo   := na
    dayBias := 0
if canTouch and not preOpen and not na(dayLo)
    bool brkLo = tLo < dayLo
    bool brkHi = tHi > dayHi
    if brkLo and not brkHi
        dayBias := 1
    else if brkHi and not brkLo
        dayBias := -1
dayHi := na(dayHi) ? high : math.max(dayHi, high)
dayLo := na(dayLo) ? low  : math.min(dayLo, low)

// Backtest en R sur les positions cloturees : gains / pertes, courbe cumulee, drawdown max
var int   stN     = 0
var int   stWin   = 0
var int   stLoss  = 0
var float stGainR = 0.
var float stLossR = 0.
var float stCum   = 0.
var float stPeak  = 0.
var float stDD    = 0.

var int   nTrades    = 0       // positions ouvertes pendant la seance
var bool  tpDone     = false   // un TP a ete atteint pendant la seance -> plus de position
var int   lastClosed = 0
var int   entrySess  = na      // seance (d_start) de la position en cours
var float entryPx    = na
var float slPx       = na
var float tpPx       = na
var float riskR      = na
var int   slStep     = 0       // 0 : SL initial, 1 : break-even, 2 : SL a +25 % du TP
var bool  pend       = false   // ordre d'entree passe a la bougie precedente : execution a verifier
var int   pendClosed = 0       // trades clotures au moment de l'ordre
var label pendLbl    = na      // son losange

if new_sess
    nTrades := 0
    tpDone  := false

// (0) L'ordre d'entree de la bougie precedente n'apparait pas dans la liste des trades
//     (refuse par TradingView) : son losange est supprime et la position n'est pas comptee.
if pend
    if strategy.position_size == 0 and strategy.closedtrades == pendClosed
        nTrades := math.max(nTrades - 1, 0)
        label.delete(pendLbl)
    pend := false

// (1) Position cloturee sur cette bougie : TP -> plus de position aujourd'hui ;
//     SL, break-even ou SL a +25 % -> une 2e position reste possible.
//     Notification du resultat en R (gain par contrat / risque initial) : etiquette + alerte.
if strategy.closedtrades > lastClosed
    int   n      = strategy.closedtrades - 1
    float xp     = strategy.closedtrades.exit_price(n)
    bool  isLong = strategy.closedtrades.size(n) > 0
    bool  hitTp  = isLong ? xp >= tpPx - syminfo.mintick / 2 : xp <= tpPx + syminfo.mintick / 2
    if hitTp and entrySess == d_start
        tpDone := true
    float  rr   = (xp - strategy.closedtrades.entry_price(n)) * (isLong ? 1 : -1) / riskR
    float  pnl  = strategy.closedtrades.profit(n)
    stN     += 1
    stWin   += rr > 0.05 ? 1 : 0
    stLoss  += rr < -0.05 ? 1 : 0
    stGainR += math.max(rr, 0)
    stLossR += math.max(-rr, 0)
    stCum   += rr
    stPeak  := math.max(stPeak, stCum)
    stDD    := math.max(stDD, stPeak - stCum)
    string kind = hitTp ? "TP" : slStep == 0 ? "SL" : slStep == 1 ? "BE" : "SL à +25 %"
    string txt  = kind + " · " + (rr >= 0 ? "+" : "") + str.tostring(rr, "#.##") + "R"
    if showR
        label.new(strategy.closedtrades.exit_bar_index(n), xp, txt, style=label.style_label_left, size=size.small, textcolor=color.white,
             color=color.new(rr > 0.05 ? #26a69a : rr < -0.05 ? #ef5350 : color.gray, 10), tooltip=txt + " · " + str.tostring(pnl, "#.##") + " $")
    alert(syminfo.ticker + " · " + txt + " (" + str.tostring(pnl, "#.##") + " $)", alert.freq_once_per_bar)
    lastClosed := strategy.closedtrades

// (2) Position en cours : SL deplace selon le chemin parcouru vers le TP (prog : 0 = entree,
//     1 = TP). TP a plus de 3R : break-even a 25 %, SL a +25 % du TP a 75 %.
//     Sinon : break-even a 50 %.
f_manage(prog, dTp, dir) =>
    int   step = slStep
    float sl   = slPx
    if dTp > 3 * riskR
        if step < 2 and prog >= 0.75
            step := 2
            sl   := entryPx + dir * 0.25 * dTp
        else if step < 1 and prog >= 0.25
            step := 1
            sl   := entryPx
    else if step < 1 and prog >= 0.5
        step := 1
        sl   := entryPx
    [step, sl]

if strategy.position_size > 0
    [stp, sl] = f_manage((high - entryPx) / (tpPx - entryPx), tpPx - entryPx, 1)
    slStep := stp
    slPx   := sl
    strategy.exit("XL", "L", stop=slPx, limit=tpPx)
if strategy.position_size < 0
    [stp, sl] = f_manage((entryPx - low) / (entryPx - tpPx), entryPx - tpPx, -1)
    slStep := stp
    slPx   := sl
    strategy.exit("XS", "S", stop=slPx, limit=tpPx)

// (3) Nouvelle position : a plat, quota de la seance non atteint, pas de TP aujourd'hui, sens
//     autorise par le range du jour, un niveau intact pour le TP et au moins un contrat.
bool  canOpen  = strategy.position_size == 0 and not tpDone and nTrades < maxTrades
bool  bTook    = false
bool  sTook    = false
float takenQty = na
if buySig and canOpen and dayBias >= 0
    float tp = f_nextLevel(close, 1)
    float q  = close > sigSL ? f_qty(close - sigSL) : 0.
    if not na(tp) and q > 0
        entryPx   := close
        slPx      := sigSL
        tpPx      := tp
        riskR     := close - sigSL
        slStep    := 0
        entrySess := d_start
        nTrades   += 1
        bTook     := true
        takenQty  := q
        strategy.entry("L", strategy.long, qty=q, comment=str.tostring(q) + " ct · " + str.tostring(q * riskR * pointUsd, "#") + " $")
        strategy.exit("XL", "L", stop=slPx, limit=tpPx)
if sellSig and canOpen and dayBias <= 0 and not bTook
    float tp = f_nextLevel(close, -1)
    float q  = close < sigSL ? f_qty(sigSL - close) : 0.
    if not na(tp) and q > 0
        entryPx   := close
        slPx      := sigSL
        tpPx      := tp
        riskR     := sigSL - close
        slStep    := 0
        entrySess := d_start
        nTrades   += 1
        sTook     := true
        takenQty  := q
        strategy.entry("S", strategy.short, qty=q, comment=str.tostring(q) + " ct · " + str.tostring(q * riskR * pointUsd, "#") + " $")
        strategy.exit("XS", "S", stop=slPx, limit=tpPx)

// Losange de couleur sur chaque position ouverte (taille et risque au survol).
// L'execution reelle de l'ordre est verifiee a la bougie suivante (etape 0).
if bTook or sTook
    pend       := true
    pendClosed := strategy.closedtrades
    pendLbl    := sigOn ? label.new(bar_index, bTook ? low : high, "", yloc=bTook ? yloc.belowbar : yloc.abovebar, style=label.style_diamond, color=color.new(bTook ? cBuy : cSell, 30), size=size.tiny, tooltip=(bTook ? "Achat : " : "Vente : ") + str.tostring(takenQty) + " ct, risque " + str.tostring(takenQty * riskR * pointUsd, "#") + " $") : na

plot(strategy.position_size != 0 ? slPx : na, "SL", color.red,   style=plot.style_linebr)
plot(strategy.position_size != 0 ? tpPx : na, "TP", color.green, style=plot.style_linebr)

//========================== BACKTEST (R) ==========================
var table stTbl = table.new(position.top_right, 2, 7, bgcolor=color.new(#131722, 10), border_width=1, border_color=color.new(color.gray, 70))

f_r(x) => (x >= 0 ? "+" : "") + str.tostring(x, "#.##") + "R"

f_row(r, k, v, c) =>
    table.cell(stTbl, 0, r, k, text_color=color.silver, text_size=size.small, text_halign=text.align_left)
    table.cell(stTbl, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)

if showStats and barstate.islast
    color cPos = #26a69a
    color cNeg = #ef5350
    float pf   = stLossR > 0 ? stGainR / stLossR : na
    float expR = stN > 0 ? stCum / stN : 0.
    table.cell(stTbl, 0, 0, "Backtest en R", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(stTbl, 1, 0, syminfo.ticker, text_color=color.silver, text_size=size.small, text_halign=text.align_right)
    f_row(1, "Trades", str.tostring(stN) + "  (" + str.tostring(stWin) + " G / " + str.tostring(stLoss) + " P / " + str.tostring(stN - stWin - stLoss) + " BE)", color.white)
    f_row(2, "Win rate", stN > 0 ? str.tostring(100.0 * stWin / stN, "#.#") + " %" : "-", color.white)
    f_row(3, "Profit factor", na(pf) ? (stGainR > 0 ? "inf." : "-") : str.tostring(pf, "#.##"), na(pf) or pf >= 1 ? cPos : cNeg)
    f_row(4, "Esperance / trade", f_r(expR), expR >= 0 ? cPos : cNeg)
    f_row(5, "PnL total", f_r(stCum), stCum >= 0 ? cPos : cNeg)
    f_row(6, "Drawdown max", "-" + str.tostring(stDD, "#.##") + "R", cNeg)
